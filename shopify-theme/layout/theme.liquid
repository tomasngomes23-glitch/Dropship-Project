<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="{{ page_description | default: 'Aurora Cube by Velory — the crystal-glass light that turns any room into an aurora borealis. 16 colors, remote control, free shipping.' | escape }}" />
    <title>{{ page_title | default: 'Aurora Cube — Velory' }}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <script>
      window.theme = { moneyFormat: {{ shop.money_format | json }} };
    </script>

    {{ content_for_header }}
  </head>
  <body>
    <div
      data-cursor-glow
      aria-hidden="true"
      class="pointer-events-none fixed left-0 top-0 z-0 hidden h-[26rem] w-[26rem] rounded-full opacity-[0.15] mix-blend-screen lg:block"
      style="background: radial-gradient(circle, rgba(45,212,191,0.9), rgba(168,85,247,0.5) 45%, transparent 70%); filter: blur(40px);"
    ></div>

    {% sections 'header-group' %}

    <main>
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
