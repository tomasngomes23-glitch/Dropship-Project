<section class="px-5 py-20 lg:px-8">
  <div data-reveal data-track-order class="mx-auto text-center transition-[max-width]" style="max-width: 36rem;">
    {% render 'icon', name: 'package-search', size: 36, class: 'mx-auto text-teal-300' %}
    <h1 class="mt-4 font-display text-3xl font-semibold text-white sm:text-4xl">
      {{ section.settings.heading | default: 'Track your order' }}
    </h1>
    <p class="mt-3 text-neutral-400">
      {{ section.settings.subheading | default: "Please enter you tracking number below. If your tracking number doesn't work feel free to contact us." }}
    </p>

    <form data-track-form class="mt-8 flex flex-col gap-4 text-left">
      <input
        type="text"
        required
        data-track-input
        placeholder="{{ 'general.track_order.tracking_number' | t }}"
        class="rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3 text-sm text-white placeholder:text-neutral-500 outline-none focus:border-teal-300"
      />
      <button
        type="submit"
        class="mt-2 w-full rounded-full bg-teal-400 py-3.5 text-sm font-bold text-neutral-950 transition-transform hover:scale-[1.01] cursor-pointer"
      >
        {{ 'general.track_order.track_order' | t }}
      </button>
    </form>

    <div data-track-result class="mt-8 hidden overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] text-left">
      <div data-track-error class="hidden p-5 text-sm text-neutral-400">
        {{ 'general.track_order.widget_error' | t }}
        <a data-track-fallback-link href="#" target="_blank" rel="noopener noreferrer" class="text-teal-300 underline">{{ 'general.track_order.track_directly' | t }}</a>.
      </div>
      <div id="track-order-widget" data-track-widget></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Track order",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Track your order" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Please enter you tracking number below. If your tracking number doesn't work feel free to contact us." }
  ]
}
{% endschema %}
