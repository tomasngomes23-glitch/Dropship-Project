<section class="px-5 py-20 lg:px-8">
  <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2">
    <div data-reveal="left" class="group order-2 overflow-hidden rounded-[2rem] lg:order-1">
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 1000 }}"
          alt="Rapaz na cama a admirar o brilho do Aurora Cube"
          width="1000"
          height="1000"
          class="w-full transition-transform duration-500 group-hover:scale-105"
        />
      {%- else -%}
        <img
          src="{{ 'cube-guy-bed.webp' | asset_url }}"
          alt="Rapaz na cama a admirar o brilho do Aurora Cube"
          width="1000"
          height="1000"
          class="w-full transition-transform duration-500 group-hover:scale-105"
        />
      {%- endif -%}
    </div>

    <div data-reveal="right" data-reveal-delay="100" class="order-1 lg:order-2">
      <span class="inline-flex items-center gap-2 rounded-full bg-red-500/10 px-3 py-1 text-xs font-semibold text-red-400">
        {% render 'icon', name: 'flame', size: 13 %}
        {{ section.settings.badge_text | default: 'We recently went viral — stock is limited' }}
      </span>

      <h2 class="mt-4 font-display text-3xl font-semibold text-white sm:text-4xl">
        {{ section.settings.heading | default: 'Our Guarantee' }}
      </h2>
      <p class="mt-4 max-w-md text-neutral-400">
        {{ section.settings.body | default: "If you're not 100% satisfied within the first 30 days, just send it back and we'll give you a full refund. No need to worry about return shipping — we've got you covered." }}
      </p>

      <div class="mt-8 space-y-4">
        <div class="flex items-start gap-3 rounded-xl p-2 -m-2 transition-colors duration-200 hover:bg-white/[0.04]">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-teal-400/10 text-teal-300">
            {% render 'icon', name: 'shield-check', size: 17 %}
          </span>
          <div>
            <p class="font-medium text-white">30-day money-back guarantee</p>
            <p class="text-sm text-neutral-400">Risk-free, no questions asked.</p>
          </div>
        </div>
        <div class="flex items-start gap-3 rounded-xl p-2 -m-2 transition-colors duration-200 hover:bg-white/[0.04]">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-teal-400/10 text-teal-300">
            {% render 'icon', name: 'package-check', size: 17 %}
          </span>
          <div>
            <p class="font-medium text-white">Tracked shipping included</p>
            <p class="text-sm text-neutral-400">Orders processed in 24-72h, delivered in 6-15 days depending on your location.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Guarantee",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "We recently went viral — stock is limited" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Guarantee" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "If you're not 100% satisfied within the first 30 days, just send it back and we'll give you a full refund. No need to worry about return shipping — we've got you covered." }
  ]
}
{% endschema %}
