<section class="px-5 py-20 lg:px-8">
  <div data-reveal class="mx-auto max-w-xl">
    <h1 class="font-display text-3xl font-semibold text-white sm:text-4xl">
      {{ section.settings.heading | default: 'Contact' }}
    </h1>
    <p class="mt-3 text-neutral-400">
      {{ section.settings.subheading | default: "Questions about your order or the Aurora Cube? Send us a message and we'll get back to you within 24 hours." }}
    </p>

    {% form 'contact' %}
      {% if form.posted_successfully? %}
        <div class="mt-8 flex items-center gap-2 rounded-2xl border border-teal-400/20 bg-teal-400/5 px-5 py-4 text-sm text-teal-300">
          {% render 'icon', name: 'check', size: 18 %}
          Thanks! We've received your message and will reply soon.
        </div>
      {% else %}
        <div class="mt-8 flex flex-col gap-4">
          <div class="grid gap-4 sm:grid-cols-2">
            <input
              type="text"
              name="contact[name]"
              placeholder="Name"
              class="rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3 text-sm text-white placeholder:text-neutral-500 outline-none focus:border-teal-300"
            />
            <input
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              required
              placeholder="Email *"
              class="rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3 text-sm text-white placeholder:text-neutral-500 outline-none focus:border-teal-300"
            />
          </div>
          <input
            type="tel"
            name="contact[phone]"
            placeholder="Phone number"
            class="rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3 text-sm text-white placeholder:text-neutral-500 outline-none focus:border-teal-300"
          />
          <textarea
            name="contact[body]"
            placeholder="Comment"
            rows="5"
            class="rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3 text-sm text-white placeholder:text-neutral-500 outline-none focus:border-teal-300"
          >{{ form.body }}</textarea>
          <button
            type="submit"
            class="mt-2 w-full rounded-full bg-teal-400 py-3.5 text-sm font-bold text-neutral-950 transition-transform hover:scale-[1.01] cursor-pointer sm:w-auto sm:px-8"
          >
            Send
          </button>
        </div>
      {% endif %}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Questions about your order or the Aurora Cube? Send us a message and we'll get back to you within 24 hours." }
  ]
}
{% endschema %}
