<section id="faq" class="px-5 py-20 lg:px-8">
  <div class="mx-auto max-w-3xl">
    <h2 data-reveal class="mb-10 text-center font-display text-3xl font-semibold text-white sm:text-4xl">
      {{ section.settings.heading | default: 'Frequently Asked Questions' }}
    </h2>

    <div data-faq-list class="flex flex-col gap-3">
      {% for block in section.blocks %}
        <div
          data-reveal
          data-reveal-delay="{{ forloop.index0 | times: 40 }}"
          data-faq-item
          class="overflow-hidden rounded-2xl border bg-white/[0.03] transition-colors duration-200{% if forloop.first %} border-teal-400/30{% else %} border-white/10 hover:border-white/25{% endif %}"
        >
          <button
            type="button"
            data-faq-trigger
            class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left cursor-pointer"
          >
            <span class="font-medium text-white">{{ block.settings.question }}</span>
            <span
              data-faq-icon
              class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-white/5 text-neutral-300 transition-transform duration-200 hover:scale-[1.15]{% if forloop.first %} rotate-45{% endif %}"
            >
              {% render 'icon', name: 'plus', size: 14 %}
            </span>
          </button>
          <div data-faq-panel class="accordion-rows" {% if forloop.first %}data-open{% endif %}>
            <div>
              <p class="px-5 pb-5 text-sm text-neutral-400">{{ block.settings.answer }}</p>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How big is it?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Compact and portable." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "faq", "settings": { "question": "How big is it?", "answer": "Compact and portable at approximately 8x8cm. Small enough for any surface but powerful enough to light up an entire room." } },
      { "type": "faq", "settings": { "question": "How many colors does it have?", "answer": "16 color options controllable instantly with the included remote. No app or WiFi needed." } },
      { "type": "faq", "settings": { "question": "How long does shipping take?", "answer": "7-14 business days across Europe. Tracking number provided as soon as your order ships." } },
      { "type": "faq", "settings": { "question": "Is it safe to leave on overnight?", "answer": "Yes — energy efficient LED stays cool to the touch even after hours of use." } },
      { "type": "faq", "settings": { "question": "How fast is shipping?", "answer": "We process orders within 24-72 hours and deliver them within 6-15 days depending on your location, with tracked shipment included for your convenience." } },
      { "type": "faq", "settings": { "question": "How do I get in contact?", "answer": "You can message support by clicking the \"Contact Us\" section on our store." } }
    ]
  }
}
{% endschema %}
