<section id="reviews" class="px-5 py-20 lg:px-8">
  <div class="mx-auto max-w-6xl">
    <div data-reveal class="mb-12 text-center">
      <h2 class="font-display text-3xl font-semibold text-white sm:text-4xl">
        {{ section.settings.heading | default: 'What Customers Are Raving About' }}
      </h2>
    </div>

    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <div data-reveal="scale" class="group overflow-hidden rounded-[2rem]">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1000 }}"
            alt="Colagem de clientes felizes a usar o Aurora Cube"
            width="1000"
            height="1000"
            class="w-full transition-transform duration-500 group-hover:scale-105"
          />
        {%- else -%}
          <img
            src="{{ 'cube-collage-reviews.webp' | asset_url }}"
            alt="Colagem de clientes felizes a usar o Aurora Cube"
            width="1000"
            height="1000"
            class="w-full transition-transform duration-500 group-hover:scale-105"
          />
        {%- endif -%}
      </div>

      <div class="flex flex-col gap-4">
        {%- assign avatar_colors = 'from-teal-300 to-emerald-500|from-fuchsia-300 to-purple-500|from-amber-300 to-orange-500' | split: '|' -%}
        {% for block in section.blocks %}
          {%- assign color_index = forloop.index0 | modulo: 3 -%}
          <div
            data-reveal="right"
            data-reveal-delay="{{ forloop.index0 | times: 100 }}"
            class="rounded-2xl border border-white/10 bg-white/[0.03] p-5 transition-all duration-200 hover:border-teal-400/30 hover:bg-white/[0.05] hover:-translate-y-1 hover:scale-[1.01]"
          >
            <div class="flex text-amber-400">
              {% for i in (1..block.settings.rating) %}
                {% render 'icon', name: 'star', size: 14, class: 'fill-current' %}
              {% endfor %}
            </div>
            <p class="mt-3 text-sm text-neutral-200">&quot;{{ block.settings.quote }}&quot;</p>
            <div class="mt-3 flex items-center gap-2.5">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-gradient-to-br text-[11px] font-semibold text-neutral-950 {{ avatar_colors[color_index] }}">
                {{ block.settings.name | slice: 0, 1 }}
              </span>
              <p class="text-xs font-medium text-neutral-500">{{ block.settings.name }}, {{ block.settings.location }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Customers Are Raving About" },
    { "type": "image_picker", "id": "image", "label": "Collage image" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Emma K." },
        { "type": "text", "id": "location", "label": "Location", "default": "Stockholm" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "My room looks completely different now." },
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "default": 5 }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "testimonial", "settings": { "name": "Emma K.", "location": "Stockholm", "quote": "My room looks completely different now. Everyone who visits asks where I got it.", "rating": 5 } },
      { "type": "testimonial", "settings": { "name": "Sofia M.", "location": "Amsterdam", "quote": "Bought this as a gift and he was speechless. Absolutely worth it.", "rating": 5 } },
      { "type": "testimonial", "settings": { "name": "James R.", "location": "London", "quote": "Genuinely stunning. Best impulse buy I've ever made.", "rating": 5 } }
    ]
  }
}
{% endschema %}
