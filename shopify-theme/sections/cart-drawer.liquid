{%- liquid
  assign line = cart.items.first
  assign free_shipping_qty = settings.free_shipping_qty | default: 3
  assign remaining = free_shipping_qty | minus: cart.item_count
  assign progress_pct = cart.item_count | times: 100.0 | divided_by: free_shipping_qty | at_most: 100
-%}
<div
  data-cart-backdrop
  class="panel-fade fixed inset-0 z-50 bg-black/60 backdrop-blur-sm"
></div>

<aside
  data-cart-drawer
  class="panel-slide-x fixed right-0 top-0 z-50 flex h-full w-full max-w-md flex-col bg-neutral-900 shadow-2xl"
>
  <div class="flex items-center justify-between border-b border-white/10 px-6 py-5">
    <h2 class="flex items-center gap-2 font-display text-lg font-semibold text-white">
      {% render 'icon', name: 'shopping-bag', size: 20 %}
      {{ 'general.cart.title' | t }}
    </h2>
    <button
      type="button"
      data-cart-close
      class="flex h-9 w-9 items-center justify-center rounded-full text-neutral-400 hover:bg-white/10 hover:text-white cursor-pointer"
      aria-label="{{ 'general.cart.close_cart' | t }}"
    >
      {% render 'icon', name: 'x', size: 18 %}
    </button>
  </div>

  <div data-cart-empty class="flex flex-1 flex-col items-center justify-center gap-3 px-6 text-center{% unless cart.item_count == 0 %} hidden{% endunless %}">
    {% render 'icon', name: 'shopping-bag', size: 40, class: 'text-neutral-700' %}
    <p class="text-neutral-500">{{ 'general.cart.empty' | t }}</p>
    <button
      type="button"
      data-cart-close
      class="mt-2 rounded-full bg-teal-400 px-5 py-2.5 text-sm font-semibold text-neutral-950 cursor-pointer"
    >
      {{ 'general.cart.continue_shopping' | t }}
    </button>
  </div>

  <div data-cart-filled class="flex flex-1 flex-col{% if cart.item_count == 0 %} hidden{% endif %}">
    <div class="flex-1 overflow-y-auto px-6 py-4">
      <div
        data-cart-shipping-progress
        data-free-shipping-qty="{{ free_shipping_qty }}"
        class="mb-5 rounded-xl border border-white/10 bg-white/5 px-4 py-3"
      >
        <p
          data-shipping-progress-label
          data-unlocked-label="{{ 'general.cart.free_shipping_unlocked' | t }}"
          data-progress-label="{{ 'general.cart.free_shipping_progress' | t: count: '{count}' }}"
          class="mb-2 text-xs text-neutral-300"
        >
          {% if cart.item_count >= free_shipping_qty %}
            {{ 'general.cart.free_shipping_unlocked' | t }}
          {% else %}
            {{ 'general.cart.free_shipping_progress' | t: count: remaining }}
          {% endif %}
        </p>
        <div class="h-1.5 w-full overflow-hidden rounded-full bg-white/10">
          <div
            data-shipping-progress-bar
            class="h-full rounded-full bg-teal-400 transition-all duration-500"
            style="width: {{ progress_pct }}%;"
          ></div>
        </div>
      </div>

      <div class="flex gap-3">
        {% if line %}
          <img
            src="{{ line.image | image_url: width: 160 }}"
            alt="{{ line.product.title }}"
            width="80"
            height="96"
            class="h-24 w-20 shrink-0 rounded-xl object-cover"
          />
        {% endif %}
        <div class="flex-1">
          <div class="flex items-start justify-between gap-2">
            <p class="text-sm font-medium text-neutral-100">{{ line.product.title | default: 'Aurora Cube' }}</p>
            <button
              type="button"
              data-cart-clear
              aria-label="{{ 'general.cart.remove' | t }}"
              class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-neutral-500 transition-colors hover:bg-white/10 hover:text-red-400 cursor-pointer"
            >
              {% render 'icon', name: 'trash-2', size: 14 %}
            </button>
          </div>
          <p class="text-xs text-neutral-500">
            <span
              data-cart-qty-label
              data-single-label="{{ 'general.cart.single' | t }}"
              data-qty-label="{{ 'general.cart.qty' | t: count: '{count}' }}"
            >{% if cart.item_count == 1 %}{{ 'general.cart.single' | t }}{% else %}{{ 'general.cart.qty' | t: count: cart.item_count }}{% endif %}</span>
          </p>
          <div class="mt-2 flex items-baseline gap-2">
            <span data-cart-price class="text-sm font-semibold text-white">{{ cart.total_price | money }}</span>
            {% if cart.original_total_price > cart.total_price %}
              <span data-cart-compare class="text-xs text-neutral-500 line-through">{{ cart.original_total_price | money }}</span>
            {% endif %}
          </div>
        </div>
      </div>

      <div class="mt-5 flex items-center gap-2 rounded-xl border border-teal-400/20 bg-teal-400/5 px-3 py-2.5 text-xs text-teal-300">
        {% render 'icon', name: 'shield-check', size: 14 %}
        {{ 'general.cart.guarantee' | t }}
      </div>
    </div>

    <div class="border-t border-white/10 px-6 py-5">
      {% if cart.original_total_price > cart.total_price %}
        <div class="mb-1 flex items-center justify-between text-sm text-neutral-400">
          <span>{{ 'general.cart.you_save' | t }}</span>
          <span data-cart-savings class="text-teal-300">{{ cart.original_total_price | minus: cart.total_price | money }}</span>
        </div>
      {% endif %}
      <div class="mb-4 flex items-center justify-between">
        <span class="text-sm text-neutral-400">{{ 'general.cart.subtotal' | t }}</span>
        <span data-cart-subtotal class="font-display text-lg font-semibold text-white">{{ cart.total_price | money }}</span>
      </div>
      <a
        href="/checkout"
        class="flex w-full items-center justify-center rounded-full bg-teal-400 py-3.5 text-sm font-bold text-neutral-950 transition-transform hover:scale-[1.02]"
      >
        {{ 'general.cart.checkout' | t }}
      </a>
      <p class="mt-3 text-center text-xs text-neutral-600">{{ 'general.cart.free_shipping' | t }} &middot; {{ 'general.cart.tracked_delivery' | t }}</p>
    </div>
  </div>
</aside>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
