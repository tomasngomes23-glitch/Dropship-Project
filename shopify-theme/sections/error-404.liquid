<section class="flex min-h-[70vh] flex-col items-center justify-center px-5 py-24 text-center">
  <div class="mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-white/5 text-neutral-500">
    {% render 'icon', name: 'package-search', size: 36 %}
  </div>
  <h1 class="font-display text-3xl font-semibold text-white sm:text-4xl">
    {{ 'general.404.heading' | t }}
  </h1>
  <p class="mx-auto mt-3 max-w-md text-neutral-400">
    {{ 'general.404.body' | t }}
  </p>
  <a
    href="/"
    class="mt-8 inline-flex items-center justify-center rounded-full bg-teal-400 px-6 py-3 text-sm font-bold text-neutral-950 transition-transform hover:scale-[1.02]"
  >
    {{ 'general.404.cta' | t }}
  </a>
</section>

{% schema %}
{
  "name": "Error 404 page",
  "settings": []
}
{% endschema %}
