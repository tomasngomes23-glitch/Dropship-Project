<section class="px-5 py-20 lg:px-8">
  <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2">
    <div
      data-reveal="left"
      class="overflow-hidden rounded-[2rem] shadow-[0_0_0_0_rgba(45,212,191,0)] transition-shadow duration-300 hover:shadow-[0_0_50px_-10px_rgba(45,212,191,0.35)]"
    >
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 1000 }}"
          alt="{{ section.settings.heading }}"
          width="1000"
          height="1000"
          class="w-full transition-transform duration-500 hover:scale-105"
        />
      {%- else -%}
        <img
          src="{{ 'cube-woman-pink.webp' | asset_url }}"
          alt="{{ section.settings.heading }}"
          width="1000"
          height="1000"
          class="w-full transition-transform duration-500 hover:scale-105"
        />
      {%- endif -%}
    </div>

    <div data-reveal="right" data-reveal-delay="100">
      <h2 class="font-display text-3xl font-semibold text-white sm:text-4xl">
        {{ section.settings.heading | default: 'Turn Any Room Into a Sanctuary' }}
      </h2>
      <p class="mt-4 max-w-md text-neutral-400">
        {{ section.settings.body | default: 'One cube is all it takes to completely transform how your space feels. No renovation, no hassle. Just instant ambiance at the touch of a button.' }}
      </p>

      <div class="mt-8 space-y-4">
        {% for block in section.blocks %}
          <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4 transition-all duration-200 hover:border-teal-400/30 hover:bg-white/[0.05] hover:translate-x-1">
            <p class="font-medium text-white">{{ block.settings.title }}</p>
            <p class="mt-0.5 text-sm text-neutral-400">{{ block.settings.body }}</p>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Transform",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Turn Any Room Into a Sanctuary" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "One cube is all it takes to completely transform how your space feels. No renovation, no hassle. Just instant ambiance at the touch of a button." }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Instant mood upgrade" },
        { "type": "text", "id": "body", "label": "Body", "default": "Plug in and your room transforms in seconds." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "feature", "settings": { "title": "Instant mood upgrade", "body": "Plug in and your room transforms in seconds." } },
      { "type": "feature", "settings": { "title": "Perfect for any occasion", "body": "Movie night, date night, or just unwinding." } },
      { "type": "feature", "settings": { "title": "Impresses everyone", "body": "Looks far more expensive than it really is." } }
    ]
  }
}
{% endschema %}
