<section class="px-5 pb-20 pt-10 lg:px-8 lg:pt-12">
  <div class="mx-auto max-w-6xl">
    <div data-reveal class="mb-12 text-center">
      <h2 class="font-display text-3xl font-semibold text-white sm:text-4xl">
        {{ section.settings.heading | default: 'Simple To Use, Impossible To Ignore' }}
      </h2>
      <p class="mx-auto mt-3 max-w-lg text-neutral-400">
        {{ section.settings.subheading | default: 'The crystal glass projects stunning light patterns across your walls and ceiling. Perfect atmosphere in seconds.' }}
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-3">
      {% for block in section.blocks %}
        <div
          data-reveal
          data-reveal-delay="{{ forloop.index0 | times: 120 }}"
          class="group overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] transition-colors duration-300 hover:border-teal-400/30 hover:-translate-y-1.5"
          style="transition: transform 0.3s ease, border-color 0.3s ease, opacity 0.6s ease-out, translate 0.6s ease-out;"
        >
          <div class="overflow-hidden">
            {%- liquid
              case forloop.index
                when 1
                  assign fallback_image = 'cube-portable-hand.webp'
                when 2
                  assign fallback_image = 'cube-colors-desk.webp'
                else
                  assign fallback_image = 'cube-dimming-bedside.webp'
              endcase
            -%}
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                alt="{{ block.settings.title }}"
                width="800"
                height="800"
                class="aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            {%- else -%}
              <img
                src="{{ fallback_image | asset_url }}"
                alt="{{ block.settings.title }}"
                width="800"
                height="800"
                class="aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            {%- endif -%}
          </div>
          <div class="p-5">
            <span class="font-display text-xs font-semibold text-teal-300">{{ block.settings.number }}</span>
            <p class="mt-1 font-medium text-white">{{ block.settings.title }}</p>
            <p class="mt-1 text-sm text-neutral-400">{{ block.settings.body }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Simple To Use, Impossible To Ignore" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "The crystal glass projects stunning light patterns across your walls and ceiling. Perfect atmosphere in seconds." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "01" },
        { "type": "text", "id": "title", "label": "Title", "default": "Place & Plug In" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Set the Aurora Cube on any surface and plug it in." },
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "step", "settings": { "number": "01", "title": "Place & Plug In", "body": "Set the Aurora Cube on any surface and plug it in. No app, no WiFi, no complicated setup." } },
      { "type": "step", "settings": { "number": "02", "title": "Pick Your Color", "body": "16 color options controlled instantly with the included remote — find your vibe in seconds." } },
      { "type": "step", "settings": { "number": "03", "title": "Dim to Perfection", "body": "Stepless dimming lets you adjust brightness exactly how you like it, day or night." } }
    ]
  }
}
{% endschema %}
