{%- comment -%}
  Email capture popup shown once per visitor (localStorage-gated) offering
  10% off. Reuses the same customer newsletter form as the footer, tagged
  separately so subscribers from this popup can be told apart in Shopify.
{%- endcomment -%}

<style>
  .welcome-popup-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease;
  }

  .welcome-popup-overlay.is-visible {
    opacity: 1;
    visibility: visible;
  }

  .welcome-popup {
    position: relative;
    background: #ffffff;
    width: 100%;
    max-width: 760px;
    border-radius: 4px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
    transform: translateY(12px);
    transition: transform 0.25s ease;
    display: flex;
    overflow: hidden;
    max-height: 90vh;
  }

  .welcome-popup-overlay.is-visible .welcome-popup {
    transform: translateY(0);
  }

  .welcome-popup__panel {
    width: 50%;
    padding: 3.5rem 3rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .welcome-popup__image-panel {
    width: 50%;
    background: #e5e5e5;
    position: relative;
  }

  .welcome-popup__image-panel img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .welcome-popup__image-placeholder {
    width: 100%;
    height: 100%;
    min-height: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1.5rem;
    font-size: 0.85rem;
    color: rgba(0, 0, 0, 0.4);
    border-left: 1px dashed rgba(0, 0, 0, 0.15);
  }

  @media screen and (max-width: 749px) {
    .welcome-popup {
      flex-direction: column;
      max-height: 92vh;
      overflow-y: auto;
    }

    .welcome-popup__panel,
    .welcome-popup__image-panel {
      width: 100%;
    }

    .welcome-popup__image-panel {
      order: -1;
      min-height: 220px;
    }
  }

  .welcome-popup__close {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    width: 2.4rem;
    height: 2.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    border-radius: 50%;
    color: #191919;
    z-index: 1;
  }

  .welcome-popup__close:hover {
    background: rgba(0, 0, 0, 0.06);
  }

  .welcome-popup__close svg {
    width: 1.3rem;
    height: 1.3rem;
  }

  .welcome-popup__logo {
    max-width: 160px;
    margin: 0 0 2rem;
  }

  .welcome-popup__logo img {
    width: 100%;
    height: auto;
    display: block;
  }

  .welcome-popup__logo-text {
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    margin: 0 0 2rem;
  }

  .welcome-popup__heading {
    font-size: 2.2rem;
    font-weight: 800;
    line-height: 1.2;
    margin: 0 0 2rem;
    text-transform: uppercase;
  }

  .welcome-popup__heading .welcome-popup__heading-big {
    display: block;
    font-size: 3.4rem;
    line-height: 1.05;
    margin-top: 0.2rem;
  }

  .welcome-popup__form {
    width: 100%;
  }

  .welcome-popup__form .field {
    margin-bottom: 1rem;
  }

  .welcome-popup__form .field__input {
    text-align: center;
  }

  .welcome-popup__submit {
    width: 100%;
    background: #000000;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 1.3rem 1.5rem;
    font-size: 1.05rem;
    font-weight: 700;
    cursor: pointer;
  }

  .welcome-popup__submit:hover {
    background: #1a1a1a;
  }

  .welcome-popup__decline {
    display: inline-block;
    margin-top: 1.25rem;
    font-size: 0.85rem;
    color: rgba(var(--color-foreground), 0.6);
    text-decoration: underline;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .welcome-popup__success {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .welcome-popup__success-icon {
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    background: #e7f4ee;
    color: #007f4e;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .welcome-popup__success-icon svg {
    width: 1.8rem;
    height: 1.8rem;
    fill: currentColor;
  }

  .welcome-popup__code {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.75rem 1.5rem;
    border: 2px dashed #191919;
    border-radius: 4px;
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }
</style>

<div class="welcome-popup-overlay" id="WelcomePopup" role="dialog" aria-modal="true" aria-labelledby="WelcomePopupHeading" hidden>
  <div class="welcome-popup">
    <button type="button" class="welcome-popup__close" id="WelcomePopupClose" aria-label="{{ 'accessibility.close' | t }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>

    <div class="welcome-popup__panel">
      <div id="WelcomePopupForm">
        {%- if settings.logo != blank -%}
          {%- assign popup_logo_height = 320 | divided_by: settings.logo.aspect_ratio -%}
          <div class="welcome-popup__logo">
            <img
              src="{{ settings.logo | image_url: width: 320 }}"
              alt="{{ shop.name }}"
              width="320"
              height="{{ popup_logo_height }}"
              loading="lazy"
            >
          </div>
        {%- else -%}
          <p class="welcome-popup__logo-text">{{ shop.name }}</p>
        {%- endif -%}

        <h2 class="welcome-popup__heading" id="WelcomePopupHeading">
          You've got
          <span class="welcome-popup__heading-big">10% off</span>
        </h2>

        {%- form 'customer', id: 'WelcomePopupNewsletter', class: 'welcome-popup__form' -%}
          {%- assign popup_posted_successfully = form.posted_successfully? -%}
          <input type="hidden" name="contact[tags]" value="newsletter,welcome-popup">
          <div class="field">
            <input
              id="WelcomePopupEmail"
              type="email"
              name="contact[email]"
              class="field__input"
              placeholder="{{ 'newsletter.label' | t }}"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              required
            >
            <label class="field__label" for="WelcomePopupEmail">{{ 'newsletter.label' | t }}</label>
          </div>
          <button type="submit" class="welcome-popup__submit">Claim Discount</button>
        {%- endform -%}

        <button type="button" class="welcome-popup__decline" id="WelcomePopupDecline">No thanks, I'd rather pay full price.</button>
      </div>

      <div id="WelcomePopupSuccess" class="welcome-popup__success" hidden>
        <span class="welcome-popup__success-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg>
        </span>
        <h2 class="welcome-popup__heading">Thank you!</h2>
        <p>Use this code at checkout:</p>
        <span class="welcome-popup__code">WELCOME10</span>
      </div>
    </div>

    <div class="welcome-popup__image-panel">
      <div class="welcome-popup__image-placeholder">[PLACEHOLDER — coloca aqui a foto do popup]</div>
    </div>
  </div>
</div>

<script>
  (function () {
    var STORAGE_KEY = 'overtakeWelcomePopupDismissed';
    var overlay = document.getElementById('WelcomePopup');
    if (!overlay) return;

    var closeButton = document.getElementById('WelcomePopupClose');
    var declineButton = document.getElementById('WelcomePopupDecline');
    var formWrapper = document.getElementById('WelcomePopupForm');
    var successWrapper = document.getElementById('WelcomePopupSuccess');

    function alreadyDismissed() {
      try {
        return window.localStorage.getItem(STORAGE_KEY) === 'true';
      } catch (e) {
        return false;
      }
    }

    function dismiss() {
      overlay.classList.remove('is-visible');
      setTimeout(function () {
        overlay.hidden = true;
      }, 250);
      try {
        window.localStorage.setItem(STORAGE_KEY, 'true');
      } catch (e) {}
    }

    function show() {
      overlay.hidden = false;
      requestAnimationFrame(function () {
        overlay.classList.add('is-visible');
      });
    }

    if (!alreadyDismissed()) {
      setTimeout(show, 2500);
    }

    closeButton.addEventListener('click', dismiss);
    declineButton.addEventListener('click', dismiss);
    overlay.addEventListener('click', function (event) {
      if (event.target === overlay) dismiss();
    });
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && overlay.classList.contains('is-visible')) dismiss();
    });

    {%- if popup_posted_successfully -%}
      formWrapper.hidden = true;
      successWrapper.hidden = false;
      show();
      try {
        window.localStorage.setItem(STORAGE_KEY, 'true');
      } catch (e) {}
    {%- endif -%}
  })();
</script>
