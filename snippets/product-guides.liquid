{% comment %}
  Renders the Size Guide and Fan vs Player Version guides inline on the product page,
  as modals opened from links next to the variant picker — no separate page/tab needed.

  Usage:
    {% render 'product-guides', mode: 'triggers', section: section %}  (place near the variant picker)
    {% render 'product-guides', mode: 'modals', section: section %}    (place once, near the end of product-info)
{% endcomment %}

{%- if mode == 'triggers' -%}
  <div class="pg-triggers pg-triggers-{{ section.id }}">
    <modal-opener class="pg-triggers__opener" data-modal="#SizeGuideModal-{{ section.id }}">
      <button type="button" class="pg-triggers__card" aria-haspopup="dialog">
        <span class="pg-triggers__tag">No. 01</span>
        <span class="pg-triggers__label">Size guide</span>
        <span class="pg-triggers__num" data-pg-roll data-target="102" data-suffix="cm chest">--</span>
      </button>
    </modal-opener>
    <modal-opener class="pg-triggers__opener" data-modal="#VersionGuideModal-{{ section.id }}">
      <button type="button" class="pg-triggers__card" aria-haspopup="dialog">
        <span class="pg-triggers__tag">No. 02</span>
        <span class="pg-triggers__label">Fan vs Player</span>
        <span class="pg-triggers__num" data-pg-roll data-target="2" data-suffix=" versions">--</span>
      </button>
    </modal-opener>
  </div>
  {%- style -%}
    .pg-triggers-{{ section.id }} {
      --pitch: #0d1f16; --paper: #f2ede1; --ink: #14120c; --gold: #c9962f; --gold-bright: #e0b355; --live-green: #3ea65f;
      display: flex; gap: 0.85rem; margin-block: 1rem 1.5rem; flex-wrap: wrap;
    }
    .pg-triggers-{{ section.id }} .pg-triggers__card {
      position: relative; flex: 1 1 150px; text-align: left; background: var(--paper); color: var(--ink);
      border: none; cursor: pointer; padding: 0.9rem 1rem 1rem; display: flex; flex-direction: column; gap: 0.3rem;
      font-family: "Arial Narrow", Arial, sans-serif;
      clip-path: polygon(0% 8%, 6% 0%, 94% 0%, 100% 8%, 100% 92%, 94% 100%, 6% 100%, 0% 92%);
      transition: transform 0.18s ease, box-shadow 0.18s ease;
      box-shadow: 0 4px 0 rgba(0,0,0,0.22);
    }
    .pg-triggers-{{ section.id }} .pg-triggers__card:hover { transform: translateY(-3px) rotate(-0.6deg); box-shadow: 0 8px 0 rgba(0,0,0,0.25); }
    .pg-triggers-{{ section.id }} .pg-triggers__card:focus-visible { outline: 3px solid var(--gold-bright); outline-offset: 2px; }
    .pg-triggers-{{ section.id }} .pg-triggers__tag {
      font-family: ui-monospace, "SF Mono", "Cascadia Code", monospace; font-size: 0.62rem; letter-spacing: 0.08em;
      text-transform: uppercase; color: var(--gold); font-weight: 700;
    }
    .pg-triggers-{{ section.id }} .pg-triggers__label { font-weight: 800; text-transform: uppercase; font-size: 0.88rem; letter-spacing: -0.005em; }
    .pg-triggers-{{ section.id }} .pg-triggers__num {
      font-family: ui-monospace, "SF Mono", "Cascadia Code", monospace; font-weight: 700; font-size: 0.98rem;
      color: var(--ink); opacity: 0.75; font-variant-numeric: tabular-nums;
    }
  {%- endstyle -%}
  <script>
    (function () {
      var nums = document.querySelectorAll('.pg-triggers-{{ section.id }} [data-pg-roll]');
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      function roll(el) {
        var target = parseInt(el.getAttribute('data-target'), 10) || 0;
        var suffix = el.getAttribute('data-suffix') || '';
        if (reduce) { el.textContent = target + suffix; return; }
        var startTime = null, duration = 700;
        function step(ts) {
          if (!startTime) startTime = ts;
          var p = Math.min((ts - startTime) / duration, 1);
          var eased = 1 - Math.pow(1 - p, 3);
          el.textContent = Math.round(target * eased) + suffix;
          if (p < 1) requestAnimationFrame(step); else el.textContent = target + suffix;
        }
        requestAnimationFrame(step);
      }
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) { if (e.isIntersecting) { roll(e.target); io.unobserve(e.target); } });
        }, { threshold: 0.4 });
        nums.forEach(function (n) { io.observe(n); });
      } else { nums.forEach(roll); }
    })();
  </script>
{%- endif -%}

{%- if mode == 'modals' -%}
  <modal-dialog id="SizeGuideModal-{{ section.id }}" class="product-popup-modal pg-modal">
    <div role="dialog" aria-label="Size guide" aria-modal="true" class="product-popup-modal__content" tabindex="-1">
      <button id="SizeGuideModalClose-{{ section.id }}" type="button" class="product-popup-modal__toggle" aria-label="{{ 'accessibility.close' | t }}">
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>
      <div class="product-popup-modal__content-info pg-sg-{{ section.id }}">
        <h1 class="h2">Size guide</h1>
        <p class="pg-sub">Tap a size to see it come to life.</p>

        <div class="pg-sg-tabs" role="tablist">
          <button type="button" class="pg-sg-tab" data-size="S">S</button>
          <button type="button" class="pg-sg-tab" data-size="M">M</button>
          <button type="button" class="pg-sg-tab is-active" data-size="L">L</button>
          <button type="button" class="pg-sg-tab" data-size="XL">XL</button>
          <button type="button" class="pg-sg-tab" data-size="XXL">XXL</button>
        </div>

        <div class="pg-sg-wrap">
          <div class="pg-sg-figure">
            <svg viewBox="0 0 240 260" xmlns="http://www.w3.org/2000/svg">
              <path class="pg-sg-shirt" d="M70 20 L95 5 Q120 20 145 5 L170 20 L210 55 L188 85 L170 72 L170 235 Q120 245 70 235 L70 72 L52 85 L30 55 Z"/>
              <line class="pg-sg-dim" data-role="chestLine" x1="70" y1="110" x2="170" y2="110"/>
              <line class="pg-sg-dim" data-role="chestCapA" x1="70" y1="104" x2="70" y2="116"/>
              <line class="pg-sg-dim" data-role="chestCapB" x1="170" y1="104" x2="170" y2="116"/>
              <text class="pg-sg-label" x="120" y="100" text-anchor="middle">Chest</text>
              <line class="pg-sg-dim" data-role="lenLine" x1="196" y1="55" x2="196" y2="235"/>
              <line class="pg-sg-dim" data-role="lenCapA" x1="190" y1="55" x2="202" y2="55"/>
              <line class="pg-sg-dim" data-role="lenCapB" x1="190" y1="235" x2="202" y2="235"/>
              <text class="pg-sg-label" x="224" y="148" text-anchor="middle" transform="rotate(90 224 148)">Length</text>
            </svg>
          </div>
          <div>
            <div class="pg-sg-readout">
              <div class="pg-sg-stat">
                <div class="pg-sg-num" data-role="chestNum">102&ndash;107</div>
                <div class="pg-sg-statlabel">Chest, cm</div>
              </div>
              <div class="pg-sg-stat">
                <div class="pg-sg-num" data-role="lenNum">72</div>
                <div class="pg-sg-statlabel">Length, cm</div>
              </div>
            </div>
            <div class="pg-sg-fit" data-role="fitTag">Standard adult fit</div>
          </div>
        </div>

        <p class="pg-note">Garment measurements, not body measurements &mdash; lay the shirt flat, chest pit-to-pit &times;2, length shoulder seam to hem. Most replica-cut kits run slightly slimmer than casual t-shirts.</p>

        <details class="pg-sg-details">
          <summary>View full size chart</summary>
          <table>
            <thead><tr><th>Size</th><th>Chest (cm)</th><th>Length (cm)</th><th>Fit</th></tr></thead>
            <tbody>
              <tr><td>S</td><td>90&ndash;95</td><td>68</td><td>Slim adult fit</td></tr>
              <tr><td>M</td><td>96&ndash;101</td><td>70</td><td>Standard adult fit</td></tr>
              <tr><td>L</td><td>102&ndash;107</td><td>72</td><td>Standard adult fit</td></tr>
              <tr><td>XL</td><td>108&ndash;113</td><td>74</td><td>Standard adult fit</td></tr>
              <tr><td>XXL</td><td>114&ndash;119</td><td>76</td><td>Loose adult fit</td></tr>
            </tbody>
          </table>
        </details>
      </div>
    </div>
  </modal-dialog>

  <modal-dialog id="VersionGuideModal-{{ section.id }}" class="product-popup-modal pg-modal">
    <div role="dialog" aria-label="Fan vs Player Version" aria-modal="true" class="product-popup-modal__content" tabindex="-1">
      <button id="VersionGuideModalClose-{{ section.id }}" type="button" class="product-popup-modal__toggle" aria-label="{{ 'accessibility.close' | t }}">
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>
      <div class="product-popup-modal__content-info pg-vg-{{ section.id }}">
        <h1 class="h2">Fan Version vs Player Version</h1>
        <p class="pg-sub">Every First Touch kit comes in two builds. Flip the switch to compare, then pick your version below before adding to cart.</p>

        <div class="pg-vg-switch" role="tablist">
          <span class="pg-vg-thumb" aria-hidden="true"></span>
          <button type="button" class="pg-vg-btn is-active" data-version="fan">Fan Version</button>
          <button type="button" class="pg-vg-btn" data-version="player">Player Version</button>
        </div>

        <div class="pg-vg-panels">
          <div class="pg-vg-badge">
            <svg viewBox="0 0 100 110" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <pattern id="pg-vg-hex-{{ section.id }}" width="11" height="19" patternUnits="userSpaceOnUse">
                  <path d="M5.5 0 L11 3.3 L11 9.9 L5.5 13.2 L0 9.9 L0 3.3 Z" fill="none" stroke="rgba(20,18,12,0.55)" stroke-width="0.6"/>
                </pattern>
              </defs>
              <path class="pg-vg-badge-shape" d="M50 4 L90 20 C90 60 74 92 50 106 C26 92 10 60 10 20 Z"/>
              <circle class="pg-vg-print" cx="50" cy="50" r="22"/>
              <circle class="pg-vg-hex" cx="50" cy="50" r="22" fill="url(#pg-vg-hex-{{ section.id }})"/>
              <circle class="pg-vg-stitch" cx="50" cy="50" r="22"/>
            </svg>
          </div>
          <div>
            <ul class="pg-vg-list" data-role="list"></ul>
            <span class="pg-vg-price" data-role="price">Included in listed price</span>
          </div>
        </div>
      </div>
    </div>
  </modal-dialog>

  {%- style -%}
    .pg-modal {
      --pitch: #0d1f16; --paper: #f2ede1; --ink: #14120c; --gold: #c9962f; --gold-bright: #e0b355; --live-green: #3ea65f;
    }
    .pg-modal .product-popup-modal__content-info {
      max-width: 640px; background: var(--paper); color: var(--ink); font-family: "Arial Narrow", Arial, sans-serif;
    }
    .pg-modal h1.h2 { font-weight: 900; text-transform: uppercase; letter-spacing: -0.01em; }
    .pg-sub { opacity: 0.75; font-size: 0.92rem; margin-top: 0.35rem; }
    .pg-modal .pg-sg-tab:focus-visible,
    .pg-modal .pg-vg-btn:focus-visible,
    .pg-modal summary:focus-visible { outline: 3px solid var(--gold-bright); outline-offset: 2px; }

    /* size guide */
    .pg-sg-tabs { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.5rem 0; }
    .pg-sg-tab {
      border: 1px dashed rgba(20,18,12,0.35); background: transparent; color: var(--ink); padding: 0.5rem 1rem;
      cursor: pointer; font-weight: 700; font-size: 0.85rem; text-transform: uppercase; transition: all 0.25s ease;
      clip-path: polygon(0% 15%, 10% 0%, 90% 0%, 100% 15%, 100% 85%, 90% 100%, 10% 100%, 0% 85%);
    }
    .pg-sg-tab:hover { border-color: var(--gold); transform: translateY(-2px); }
    .pg-sg-tab.is-active { background: var(--gold); color: var(--ink); border-color: transparent; border-style: solid; }
    .pg-sg-wrap { display: grid; grid-template-columns: 1fr; gap: 1.5rem; align-items: center; }
    @media screen and (min-width: 550px) { .pg-sg-wrap { grid-template-columns: 1fr 1fr; } }
    .pg-sg-figure { display: flex; align-items: center; justify-content: center; }
    .pg-sg-figure svg { width: 100%; max-width: 220px; height: auto; overflow: visible; }
    .pg-sg-shirt { fill: rgba(20,18,12,0.05); stroke: rgba(20,18,12,0.45); stroke-width: 2; }
    .pg-sg-dim { stroke: var(--gold); stroke-width: 2; transition: all 0.45s cubic-bezier(.4,0,.2,1); }
    .pg-sg-label { fill: var(--gold); font-size: 12px; font-weight: 700; transition: all 0.45s cubic-bezier(.4,0,.2,1); }
    .pg-sg-readout { display: flex; gap: 1.5rem; justify-content: center; }
    .pg-sg-stat { text-align: center; }
    .pg-sg-num { font-family: ui-monospace, "SF Mono", "Cascadia Code", monospace; font-size: 1.8rem; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; color: var(--ink); }
    .pg-sg-statlabel { font-size: 0.68rem; opacity: 0.6; text-transform: uppercase; letter-spacing: 0.07em; margin-top: 0.3rem; }
    .pg-sg-fit { text-align: center; margin-top: 0.6rem; font-size: 0.9rem; opacity: 0.85; }
    .pg-note { margin-top: 1.4rem; opacity: 0.7; font-size: 0.85rem; }
    .pg-sg-details { margin-top: 1.75rem; border-top: 1px dashed rgba(20,18,12,0.3); padding-top: 1rem; }
    .pg-sg-details summary { cursor: pointer; font-weight: 700; font-size: 0.88rem; text-transform: uppercase; }
    .pg-sg-details table { width: 100%; border-collapse: collapse; margin-top: 0.85rem; font-size: 0.85rem; font-family: ui-monospace, "SF Mono", "Cascadia Code", monospace; }
    .pg-sg-details th, .pg-sg-details td { text-align: center; padding: 0.5rem 0.4rem; border: 1px dashed rgba(20,18,12,0.25); }
    .pg-sg-details th:first-child, .pg-sg-details td:first-child { text-align: left; }
    @keyframes pg-pop { from { transform: scale(0.85); opacity: 0; } to { transform: scale(1); opacity: 1; } }
    .pg-pop { animation: pg-pop 0.3s ease; }

    /* version guide */
    .pg-vg-switch {
      position: relative; display: grid; grid-template-columns: 1fr 1fr; max-width: 340px; margin: 1.5rem 0 2rem;
      border: 1px dashed rgba(20,18,12,0.35); padding: 4px;
      clip-path: polygon(0% 12%, 4% 0%, 96% 0%, 100% 12%, 100% 88%, 96% 100%, 4% 100%, 0% 88%);
    }
    .pg-vg-thumb {
      position: absolute; top: 4px; left: 4px; width: calc(50% - 4px); height: calc(100% - 8px); background: var(--gold);
      transition: transform 0.32s cubic-bezier(.34,1.56,.64,1); z-index: 0;
      clip-path: polygon(0% 12%, 6% 0%, 94% 0%, 100% 12%, 100% 88%, 94% 100%, 6% 100%, 0% 88%);
    }
    .pg-vg-switch.is-player .pg-vg-thumb { transform: translateX(100%); }
    .pg-vg-btn { position: relative; z-index: 1; background: transparent; border: none; padding: 0.6rem 0.9rem; font-weight: 800; font-size: 0.82rem; text-transform: uppercase; cursor: pointer; color: var(--ink); transition: color 0.35s ease; }
    .pg-vg-btn.is-active { color: var(--ink); }
    .pg-vg-panels { display: grid; grid-template-columns: 1fr; gap: 1.5rem; align-items: center; }
    @media screen and (min-width: 550px) { .pg-vg-panels { grid-template-columns: auto 1fr; } }
    .pg-vg-badge { display: flex; align-items: center; justify-content: center; }
    .pg-vg-badge svg { width: 130px; height: 143px; }
    .pg-vg-badge-shape { fill: rgba(20,18,12,0.06); stroke: rgba(20,18,12,0.5); stroke-width: 2; }
    .pg-vg-print { fill: var(--gold); transition: opacity 0.4s ease; }
    .pg-vg-hex { opacity: 0.5; pointer-events: none; }
    .pg-vg-stitch { fill: none; stroke: var(--gold); stroke-width: 3; stroke-dasharray: 6 5; stroke-dashoffset: 400; opacity: 0; transition: opacity 0.3s ease; }
    .pg-vg-panels.is-player .pg-vg-print { opacity: 0; }
    .pg-vg-panels.is-player .pg-vg-stitch { opacity: 1; animation: pg-stitch 1.3s ease forwards; }
    @keyframes pg-stitch { to { stroke-dashoffset: 0; } }
    .pg-vg-list { list-style: none; margin: 0; padding: 0; }
    .pg-vg-list li { display: flex; gap: 0.5rem; padding: 0.45rem 0; border-bottom: 1px dashed rgba(20,18,12,0.2); font-size: 0.9rem; opacity: 0; transform: translateX(6px); animation: pg-slide 0.35s ease forwards; }
    .pg-vg-list li::before { content: "\2014"; color: var(--gold); flex: none; }
    .pg-vg-list li:nth-child(1) { animation-delay: 0.03s; }
    .pg-vg-list li:nth-child(2) { animation-delay: 0.09s; }
    .pg-vg-list li:nth-child(3) { animation-delay: 0.15s; }
    .pg-vg-list li:nth-child(4) { animation-delay: 0.21s; }
    .pg-vg-list li:nth-child(5) { animation-delay: 0.27s; }
    @keyframes pg-slide { to { opacity: 1; transform: translateX(0); } }
    .pg-vg-price {
      display: inline-block; margin-top: 1rem; padding: 0.4rem 0.85rem; background: var(--pitch); color: var(--chalk, #f5f1e6);
      font-family: ui-monospace, "SF Mono", "Cascadia Code", monospace; font-weight: 700; font-size: 0.82rem;
      clip-path: polygon(0% 18%, 6% 0%, 94% 0%, 100% 18%, 100% 82%, 94% 100%, 6% 100%, 0% 82%);
    }
    @media (prefers-reduced-motion: reduce) {
      .pg-vg-list li, .pg-pop, .pg-vg-stitch { animation: none !important; opacity: 1 !important; transform: none !important; }
      .pg-vg-thumb, .pg-vg-btn, .pg-vg-print,
      .pg-sg-tab, .pg-sg-dim, .pg-sg-label { transition: none; }
    }
  {%- endstyle -%}

  <script>
    (function () {
      var sizes = {
        S:   { chest: '90–95',   px: 55, y1: 65, y2: 210, fit: 'Slim adult fit' },
        M:   { chest: '96–101',  px: 62, y1: 60, y2: 222, fit: 'Standard adult fit' },
        L:   { chest: '102–107', px: 70, y1: 55, y2: 235, fit: 'Standard adult fit' },
        XL:  { chest: '108–113', px: 78, y1: 50, y2: 246, fit: 'Standard adult fit' },
        XXL: { chest: '114–119', px: 85, y1: 45, y2: 258, fit: 'Loose adult fit' }
      };
      var lengths = { S: 68, M: 70, L: 72, XL: 74, XXL: 76 };
      var sgRoot = document.querySelector('.pg-sg-{{ section.id }}');
      if (sgRoot) {
        var tabs = sgRoot.querySelectorAll('.pg-sg-tab');
        var svg = sgRoot.querySelector('svg');
        var chestLine = svg.querySelector('[data-role="chestLine"]');
        var chestCapA = svg.querySelector('[data-role="chestCapA"]');
        var chestCapB = svg.querySelector('[data-role="chestCapB"]');
        var lenLine = svg.querySelector('[data-role="lenLine"]');
        var lenCapA = svg.querySelector('[data-role="lenCapA"]');
        var lenCapB = svg.querySelector('[data-role="lenCapB"]');
        var chestNum = sgRoot.querySelector('[data-role="chestNum"]');
        var lenNum = sgRoot.querySelector('[data-role="lenNum"]');
        var fitTag = sgRoot.querySelector('[data-role="fitTag"]');

        function applySize(size) {
          var d = sizes[size], half = d.px / 2, cx = 120;
          chestLine.setAttribute('x1', cx - half); chestLine.setAttribute('x2', cx + half);
          chestCapA.setAttribute('x1', cx - half); chestCapA.setAttribute('x2', cx - half);
          chestCapB.setAttribute('x1', cx + half); chestCapB.setAttribute('x2', cx + half);
          lenLine.setAttribute('y1', d.y1); lenLine.setAttribute('y2', d.y2);
          lenCapA.setAttribute('y1', d.y1); lenCapA.setAttribute('y2', d.y1);
          lenCapB.setAttribute('y1', d.y2); lenCapB.setAttribute('y2', d.y2);
          chestNum.textContent = d.chest;
          lenNum.textContent = lengths[size];
          fitTag.textContent = d.fit;
          [chestNum, lenNum, fitTag].forEach(function (el) { el.classList.remove('pg-pop'); void el.offsetWidth; el.classList.add('pg-pop'); });
          tabs.forEach(function (t) { t.classList.toggle('is-active', t.dataset.size === size); });
        }
        tabs.forEach(function (t) { t.addEventListener('click', function () { applySize(t.dataset.size); }); });
      }

      var vgData = {
        fan: {
          items: ['Screen-printed crest &amp; badges', 'Regular, relaxed everyday fit', 'Breathable polyester fabric', 'Same size chart as Player Version', 'Best for matchday, casual wear, gifting'],
          price: 'Included in listed price'
        },
        player: {
          items: ['Heat-sealed, embroidered-look crest', 'Athletic player-cut — slimmer through the body', 'Lightweight mesh-panel performance fabric', 'Same size chart — consider sizing up', 'Best for collectors, training, matchday'],
          price: '+€3.99 vs Fan Version'
        }
      };
      var vgRoot = document.querySelector('.pg-vg-{{ section.id }}');
      if (vgRoot) {
        var vgSwitch = vgRoot.querySelector('.pg-vg-switch');
        var vgPanels = vgRoot.querySelector('.pg-vg-panels');
        var vgList = vgRoot.querySelector('[data-role="list"]');
        var vgPrice = vgRoot.querySelector('[data-role="price"]');
        var vgBtns = vgRoot.querySelectorAll('.pg-vg-btn');

        function applyVersion(v) {
          vgList.innerHTML = '';
          vgData[v].items.forEach(function (t) {
            var li = document.createElement('li');
            li.innerHTML = t;
            vgList.appendChild(li);
          });
          vgPrice.textContent = vgData[v].price;
          vgSwitch.classList.toggle('is-player', v === 'player');
          vgPanels.classList.toggle('is-player', v === 'player');
          vgBtns.forEach(function (b) { b.classList.toggle('is-active', b.dataset.version === v); });
        }
        vgBtns.forEach(function (b) { b.addEventListener('click', function () { applyVersion(b.dataset.version); }); });
        applyVersion('fan');
      }
    })();
  </script>
{%- endif -%}
