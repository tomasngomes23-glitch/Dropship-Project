{%- if settings.whatsapp_number != blank -%}
  {%- assign wa_message = settings.whatsapp_default_message | url_encode -%}
  <a
    href="https://wa.me/{{ settings.whatsapp_number }}?text={{ wa_message }}"
    class="whatsapp-float-button"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="{{ 'general.whatsapp.aria_label' | t: default: 'Message us on WhatsApp' }}"
  >
    <svg viewBox="0 0 32 32" width="28" height="28" fill="currentColor" aria-hidden="true">
      <path d="M16.004 3C9.377 3 4 8.373 4 15c0 2.386.7 4.61 1.905 6.478L4 29l7.72-1.865A11.94 11.94 0 0 0 16.004 27C22.63 27 28 21.627 28 15S22.63 3 16.004 3Zm0 21.75a9.7 9.7 0 0 1-4.95-1.356l-.355-.21-4.584 1.107 1.128-4.462-.232-.366A9.69 9.69 0 0 1 5.25 15c0-5.93 4.823-10.75 10.754-10.75S26.75 9.07 26.75 15 21.935 24.75 16.004 24.75Zm5.64-7.98c-.31-.155-1.833-.905-2.117-1.008-.284-.104-.49-.155-.697.155-.207.31-.8 1.008-.98 1.215-.18.207-.362.233-.672.078-.31-.155-1.31-.483-2.494-1.538-.922-.822-1.545-1.837-1.726-2.147-.18-.31-.02-.478.136-.632.14-.14.31-.362.465-.543.155-.18.207-.31.31-.517.104-.207.052-.388-.026-.543-.078-.155-.697-1.68-.955-2.3-.252-.605-.508-.523-.697-.533l-.594-.01c-.207 0-.543.078-.827.388-.284.31-1.084 1.06-1.084 2.585 0 1.526 1.11 3 1.265 3.207.155.207 2.184 3.336 5.29 4.678.74.32 1.317.512 1.767.655.742.236 1.418.203 1.952.123.596-.089 1.833-.75 2.092-1.474.258-.724.258-1.345.18-1.474-.077-.13-.283-.207-.593-.362Z"/>
    </svg>
  </a>
{%- endif -%}

{%- style -%}
  .whatsapp-float-button {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #25D366;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
    transition: transform 0.15s ease;
  }

  .whatsapp-float-button:hover {
    transform: scale(1.08);
    color: #ffffff;
  }

  @media screen and (max-width: 749px) {
    .whatsapp-float-button {
      right: 14px;
      bottom: 14px;
      width: 50px;
      height: 50px;
    }
  }
{%- endstyle -%}
