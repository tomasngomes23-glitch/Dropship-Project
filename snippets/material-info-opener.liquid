{% comment %}
  Renders the Cotton vs No Cotton info popup opener button.

  Accepts:
  - block: {Object} the 'variant_picker' block whose settings drive the modal.
  Usage:
  {% render 'material-info-opener', block: block %}
{% endcomment %}
<modal-opener
  class="product-popup-modal__opener quick-add-hidden"
  data-modal="#MaterialInfoModal-{{ block.id }}"
>
  <button
    id="MaterialInfoPopup-{{ block.id }}"
    class="product-popup-modal__button product-popup-modal__button--icon-only link"
    type="button"
    aria-haspopup="dialog"
    aria-label="{{ block.settings.material_info_label | escape }}"
  >
    <span class="svg-wrapper">
      {{- 'icon-info.svg' | inline_asset_content -}}
    </span>
  </button>
</modal-opener>
