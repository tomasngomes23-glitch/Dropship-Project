# Shopify Storefront API credentials
# Copy this file to .env and fill in your real values.
# Get these from: Shopify Admin -> Settings -> Apps and sales channels
#   -> Develop apps -> Create an app -> Configure Storefront API scopes
#   -> Install app -> API credentials -> Storefront API access token

VITE_SHOPIFY_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=your-storefront-api-token
