{%- style -%}
  .vg-{{ section.id }} {
    --pitch: #0d1f16; --pitch-dark: #081511; --paper: #f2ede1; --ink: #14120c;
    --chalk: #f5f1e6; --gold: #c9962f; --gold-bright: #e0b355; --live-green: #3ea65f;
    background: var(--pitch); color: var(--chalk); font-family: "Arial Narrow", Arial, sans-serif;
    padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;
    background-image: radial-gradient(circle, rgba(245,241,230,0.05) 1px, transparent 1.1px); background-size: 9px 9px;
  }
  .vg-{{ section.id }} h1 { font-weight: 900; text-transform: uppercase; letter-spacing: -0.01em; }
  .vg-{{ section.id }} .vg-wrap { max-width: 780px; margin: 2.5rem auto 0; background: var(--paper); color: var(--ink); padding: 2.25rem; clip-path: polygon(0% 2%, 2% 0%, 98% 0%, 100% 2%, 100% 98%, 98% 100%, 2% 100%, 0% 98%); }
  .vg-{{ section.id }} .vg-switch { position: relative; display: grid; grid-template-columns: 1fr 1fr; max-width: 420px; margin: 0 auto 2.5rem; border: 1px dashed rgba(20,18,12,0.35); padding: 4px; clip-path: polygon(0% 10%, 4% 0%, 96% 0%, 100% 10%, 100% 90%, 96% 100%, 4% 100%, 0% 90%); }
  .vg-{{ section.id }} .vg-switch-thumb { position: absolute; top: 4px; left: 4px; width: calc(50% - 4px); height: calc(100% - 8px); background: var(--gold); transition: transform 0.35s cubic-bezier(.4,0,.2,1); z-index: 0; clip-path: polygon(0% 10%, 6% 0%, 94% 0%, 100% 10%, 100% 90%, 94% 100%, 6% 100%, 0% 90%); }
  .vg-{{ section.id }}.is-player .vg-switch-thumb { transform: translateX(100%); }
  .vg-{{ section.id }} .vg-switch button { position: relative; z-index: 1; background: transparent; border: none; padding: 0.7rem 1rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.02em; cursor: pointer; color: var(--ink); transition: color 0.35s ease; }
  .vg-{{ section.id }} .vg-switch button.is-active { color: var(--ink); }
  .vg-{{ section.id }} .vg-panels { display: grid; grid-template-columns: 1fr; gap: 2rem; align-items: center; }
  @media screen and (min-width: 750px) { .vg-{{ section.id }} .vg-panels { grid-template-columns: 1fr 1fr; } }
  .vg-{{ section.id }} .vg-badge-wrap { display: flex; align-items: center; justify-content: center; }
  .vg-{{ section.id }} svg { width: 200px; height: 200px; }
  .vg-{{ section.id }} .vg-badge-shape { fill: rgba(20,18,12,0.06); stroke: rgba(20,18,12,0.5); stroke-width: 2; }
  .vg-{{ section.id }} .vg-badge-print { fill: var(--gold); opacity: 1; transition: opacity 0.4s ease; }
  .vg-{{ section.id }} .vg-badge-stitch { fill: none; stroke: var(--gold); stroke-width: 3; stroke-dasharray: 6 5; stroke-dashoffset: 400; opacity: 0; transition: opacity 0.3s ease; }
  .vg-{{ section.id }}.is-player .vg-badge-print { opacity: 0; }
  .vg-{{ section.id }}.is-player .vg-badge-stitch { opacity: 1; animation: vg-stitch 1.4s ease forwards; }
  @keyframes vg-stitch { to { stroke-dashoffset: 0; } }
  .vg-{{ section.id }} ul.vg-list { list-style: none; padding: 0; margin: 0; }
  .vg-{{ section.id }} ul.vg-list li { display: flex; gap: 0.6rem; padding: 0.55rem 0; border-bottom: 1px dashed rgba(20,18,12,0.2); opacity: 0; transform: translateX(8px); animation: vg-in 0.4s ease forwards; }
  .vg-{{ section.id }} ul.vg-list li::before { content: "\2014"; color: var(--gold); flex: none; }
  .vg-{{ section.id }} ul.vg-list li:nth-child(1) { animation-delay: 0.05s; }
  .vg-{{ section.id }} ul.vg-list li:nth-child(2) { animation-delay: 0.12s; }
  .vg-{{ section.id }} ul.vg-list li:nth-child(3) { animation-delay: 0.19s; }
  .vg-{{ section.id }} ul.vg-list li:nth-child(4) { animation-delay: 0.26s; }
  .vg-{{ section.id }} ul.vg-list li:nth-child(5) { animation-delay: 0.33s; }
  @keyframes vg-in { to { opacity: 1; transform: translateX(0); } }
  .vg-{{ section.id }} .vg-price-pill {
    display: inline-block; margin-top: 1.25rem; padding: 0.5rem 1rem; background: var(--pitch); color: var(--chalk);
    font-family: ui-monospace, "SF Mono", "Cascadia Code", monospace; font-weight: 700; font-size: 0.9rem;
    clip-path: polygon(0% 18%, 6% 0%, 94% 0%, 100% 18%, 100% 82%, 94% 100%, 6% 100%, 0% 82%);
  }
  .vg-{{ section.id }} .vg-note { margin-top: 2.25rem; opacity: 0.75; font-size: 0.88rem; text-align: center; }
  @media (prefers-reduced-motion: reduce) {
    .vg-{{ section.id }} ul.vg-list li, .vg-{{ section.id }} .vg-badge-stitch { animation: none !important; opacity: 1 !important; transform: none !important; }
  }
{%- endstyle -%}

<div class="vg-{{ section.id }}">
  <div class="page-width">
    <h1 class="{{ section.settings.heading_size }}" style="text-align:center;">{{ section.settings.heading }}</h1>
    {%- if section.settings.intro != blank -%}
      <div class="rte" style="text-align:center; max-width:560px; margin:0.75rem auto 0;">{{ section.settings.intro }}</div>
    {%- endif -%}

    <div class="vg-wrap">
      <div class="vg-switch" role="tablist" aria-label="Choose a version">
        <span class="vg-switch-thumb" aria-hidden="true"></span>
        <button type="button" class="vg-btn is-active" data-version="fan">Fan Version</button>
        <button type="button" class="vg-btn" data-version="player">Player Version</button>
      </div>

      <div class="vg-panels">
        <div class="vg-badge-wrap">
          <svg viewBox="0 0 100 110" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path class="vg-badge-shape" d="M50 4 L90 20 C90 60 74 92 50 106 C26 92 10 60 10 20 Z"/>
            <circle class="vg-badge-print" cx="50" cy="50" r="22"/>
            <circle class="vg-badge-stitch" cx="50" cy="50" r="22"/>
          </svg>
        </div>
        <div>
          <ul class="vg-list" id="vg-list-{{ section.id }}">
          </ul>
          <span class="vg-price-pill" id="vg-price-{{ section.id }}">Included in listed price</span>
        </div>
      </div>
    </div>

    <p class="vg-note">
      Every kit on First Touch is available in both versions — pick your version (and your size)
      right on the product page before adding to cart. Fan Version is the default; switch to
      Player Version there any time.
    </p>
  </div>
</div>

<script>
(function() {
  var root = document.currentScript.closest('.vg-{{ section.id }}') || document.querySelector('.vg-{{ section.id }}');
  if (!root) return;
  var data = {
    fan: {
      items: [
        'Screen-printed crest &amp; badges',
        'Regular, relaxed everyday fit',
        'Breathable polyester fabric',
        'Same size chart as Player Version',
        'Best for: matchday, casual wear, gifting'
      ],
      price: 'Included in listed price'
    },
    player: {
      items: [
        'Heat-sealed, embroidered-look crest',
        'Athletic player-cut — slimmer through the body',
        'Lightweight mesh-panel performance fabric',
        'Same size chart — consider sizing up if between sizes',
        'Best for: collectors, training, true match-worn feel'
      ],
      price: '+€3.99 vs Fan Version'
    }
  };
  var list = root.querySelector('#vg-list-{{ section.id }}');
  var priceEl = root.querySelector('#vg-price-{{ section.id }}');
  var btns = root.querySelectorAll('.vg-btn');

  function render(version) {
    var d = data[version];
    list.innerHTML = '';
    d.items.forEach(function(text) {
      var li = document.createElement('li');
      li.innerHTML = text;
      list.appendChild(li);
    });
    priceEl.textContent = d.price;
    root.classList.toggle('is-player', version === 'player');
    btns.forEach(function(b) { b.classList.toggle('is-active', b.dataset.version === version); });
  }

  btns.forEach(function(btn) {
    btn.addEventListener('click', function() { render(btn.dataset.version); });
  });

  render('fan');
})();
</script>

{% schema %}
{
  "name": "Version guide",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fan Version vs Player Version" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "options": [ { "value": "h1", "label": "Large" }, { "value": "h0", "label": "Extra large" } ], "default": "h1" },
    { "type": "richtext", "id": "intro", "label": "Intro text", "default": "<p>Every First Touch kit comes in two builds. Flip the switch to compare.</p>" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 52 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 52 }
  ],
  "presets": [ { "name": "Version guide" } ]
}
{% endschema %}
