{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #ugc-gallery-{{ section.id }} .ugc-gallery__header {
    text-align: center;
    margin: 0 0 1.75rem;
  }

  #ugc-gallery-{{ section.id }} .ugc-gallery__heading {
    font-weight: 800;
    font-size: 1.6rem;
    margin: 0;
  }

  #ugc-gallery-{{ section.id }} .ugc-gallery__subtext {
    margin: 0.4rem 0 0;
    font-size: 0.95rem;
    color: rgba(var(--color-foreground), 0.65);
  }

  #ugc-gallery-{{ section.id }} .ugc-gallery__viewport {
    overflow: hidden;
    width: 100%;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 8%, #000 92%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 8%, #000 92%, transparent 100%);
  }

  #ugc-gallery-{{ section.id }} .ugc-gallery__track {
    display: flex;
    align-items: stretch;
    gap: 1rem;
    width: max-content;
    animation: ugc-gallery-scroll-{{ section.id }} {{ section.settings.speed }}s linear infinite;
    will-change: transform;
  }

  #ugc-gallery-{{ section.id }}:hover .ugc-gallery__track {
    animation-play-state: {% if section.settings.pause_on_hover %}paused{% else %}running{% endif %};
  }

  @keyframes ugc-gallery-scroll-{{ section.id }} {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  #ugc-gallery-{{ section.id }} .ugc-gallery__item {
    position: relative;
    flex: 0 0 auto;
    width: clamp(170px, 16vw, 230px);
    aspect-ratio: 3 / 4;
    border-radius: 10px;
    overflow: hidden;
    background: rgba(var(--color-foreground), 0.06);
  }

  #ugc-gallery-{{ section.id }} .ugc-gallery__item img,
  #ugc-gallery-{{ section.id }} .ugc-gallery__item video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #ugc-gallery-{{ section.id }} .ugc-gallery__caption {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    right: 0.75rem;
    padding: 0.5rem 0.7rem;
    background: rgba(0, 0, 0, 0.55);
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.3;
    border-radius: 6px;
    text-align: center;
  }

  #ugc-gallery-{{ section.id }} .ugc-gallery__verified {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.6rem;
    background: rgba(0, 0, 0, 0.6);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 999px;
  }

  #ugc-gallery-{{ section.id }} .ugc-gallery__verified svg {
    width: 12px;
    height: 12px;
    fill: #00b67a;
  }

  #ugc-gallery-{{ section.id }} .ugc-gallery__placeholder-label {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0.75rem;
    font-size: 0.8rem;
    color: rgba(var(--color-foreground), 0.55);
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding" id="ugc-gallery-{{ section.id }}">
    <div class="ugc-gallery__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="ugc-gallery__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subtext != blank -%}
        <p class="ugc-gallery__subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>

    <div class="ugc-gallery__viewport">
      <div class="ugc-gallery__track">
        {%- for dup in (1..2) -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'media_item' -%}
              <div class="ugc-gallery__item" {% if dup == 1 %}{{ block.shopify_attributes }}{% endif %} {% if dup > 1 %}aria-hidden="true"{% endif %}>
                {%- if block.settings.video != blank -%}
                  <video muted loop playsinline autoplay
                    {% if block.settings.image != blank %}poster="{{ block.settings.image | image_url: width: 600 }}"{% endif %}
                  >
                    {%- for source in block.settings.video.sources -%}
                      <source src="{{ source.url }}" type="{{ source.mime_type }}">
                    {%- endfor -%}
                  </video>
                {%- elsif block.settings.video_url != blank -%}
                  <video muted loop playsinline autoplay
                    {% if block.settings.image != blank %}poster="{{ block.settings.image | image_url: width: 600 }}"{% endif %}
                  >
                    <source src="{{ block.settings.video_url }}" type="video/mp4">
                  </video>
                {%- elsif block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 600 }}"
                    alt="{{ block.settings.image.alt | escape }}"
                    loading="lazy"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                  >
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  <span class="ugc-gallery__placeholder-label">Add a photo, GIF or video</span>
                {%- endif -%}
                {%- if block.settings.caption != blank -%}
                  <p class="ugc-gallery__caption">{{ block.settings.caption }}</p>
                {%- endif -%}
                {%- if block.settings.show_verified -%}
                  <span class="ugc-gallery__verified">
                    <svg viewbox="0 0 20 20" aria-hidden="true"><path d="M10 0l2.4 1.7 2.9-.3 1 2.8 2.6 1.4-.5 2.9 1.6 2.5-1.6 2.5.5 2.9-2.6 1.4-1 2.8-2.9-.3L10 20l-2.4-1.7-2.9.3-1-2.8-2.6-1.4.5-2.9L0 10l1.6-2.5-.5-2.9 2.6-1.4 1-2.8 2.9.3z"></path><path d="M8.5 13.2L5.8 10.5l1-1 1.7 1.7 4-4 1 1z" fill="#fff"></path></svg>
                    Verified
                  </span>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "UGC gallery",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Title",
      "default": "See it for yourself, no filters"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Real customers, nothing retouched."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 20,
      "max": 90,
      "step": 5,
      "unit": "s",
      "label": "Speed (seconds per cycle — lower is faster)",
      "default": 60
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 44
    }
  ],
  "blocks": [
    {
      "type": "media_item",
      "name": "Photo or video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video (optional, takes priority over the image)"
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "Video URL (advanced, used if no video picked above)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo / GIF / video poster"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption overlay (optional)"
        },
        {
          "type": "checkbox",
          "id": "show_verified",
          "label": "Show \"Verified\" badge",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "UGC gallery",
      "blocks": [
        { "type": "media_item" },
        { "type": "media_item" },
        { "type": "media_item" },
        { "type": "media_item" },
        { "type": "media_item" },
        { "type": "media_item" }
      ]
    }
  ]
}
{% endschema %}
