{%- style -%}
  .marquee-bar-{{ section.id }} {
    padding: {{ section.settings.padding_block }}px 0;
  }

  .marquee-bar-{{ section.id }} .marquee-bar__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 0 1.5rem;
  }

  .marquee-bar-{{ section.id }} .marquee-bar__message {
    font-family: var(--font-body-family);
    font-size: 1.2rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-align: center;
  }

  .marquee-bar-{{ section.id }} .marquee-bar__message a {
    color: currentColor;
    text-decoration: none;
  }

  .marquee-bar-{{ section.id }} .marquee-bar__dot {
    opacity: 0.5;
    padding: 0 0.8rem;
  }

  .marquee-bar-{{ section.id }} .marquee-bar__localization {
    position: absolute;
    right: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .marquee-bar-{{ section.id }} .marquee-bar__localization .disclosure__button {
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  @media screen and (max-width: 749px) {
    .marquee-bar-{{ section.id }} .marquee-bar__localization {
      display: none;
    }
  }
{%- endstyle -%}

{%- liquid
  assign message_blocks = section.blocks | where: 'type', 'message'
  assign show_country_selector = false
  if section.settings.enable_country_selector and localization.available_countries.size > 1
    assign show_country_selector = true
  endif
-%}

{%- if message_blocks.size > 0 or show_country_selector -%}
  <div class="color-{{ section.settings.color_scheme }} marquee-bar marquee-bar-{{ section.id }}">
    <div class="marquee-bar__inner">
      <div class="marquee-bar__message">
        {%- for block in message_blocks -%}
          <span {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
            {%- else -%}
              {{ block.settings.text | escape }}
            {%- endif -%}
          </span>
          {%- unless forloop.last -%}
            <span class="marquee-bar__dot" aria-hidden="true">&bull;</span>
          {%- endunless -%}
        {%- endfor -%}
      </div>

      {%- if show_country_selector -%}
        <div class="marquee-bar__localization">
          <localization-form data-prevent-hide>
            {%- form 'localization', id: 'AnnouncementCountryForm', class: 'localization-form' -%}
              <div>
                <h2 class="visually-hidden" id="AnnouncementCountryLabel">{{ 'localization.country_label' | t }}</h2>
                {%- render 'country-localization', localPosition: 'AnnouncementCountry' -%}
              </div>
            {%- endform -%}
          </localization-form>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "section",
  "class": "marquee-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de cor",
      "default": "scheme-2"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "Mostrar seletor de país/moeda",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_block",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Espaço vertical",
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Mensagem",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Free shipping on orders over [PLACEHOLDER]"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (opcional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Free shipping on orders over [PLACEHOLDER]" } }
      ]
    }
  ]
}
{% endschema %}
