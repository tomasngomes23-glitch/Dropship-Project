        "msg-3": { "type": "message", "settings": { "text": "FREE SHIPPING OVER €60" } },
        "msg-4": { "type": "message", "settings": { "text": "NOT CLUB AFFILIATED" } }
      },
      "block_order": ["msg-1", "msg-2", "msg-3", "msg-4"]
