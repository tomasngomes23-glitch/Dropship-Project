{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .trust-badges-{{ section.id }} {
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  }

  .trust-badges__item {
    text-align: center;
    padding: 1rem;
  }

  .trust-badges__icon svg,
  .trust-badges__icon img {
    width: 2rem;
    height: 2rem;
    margin: 0 auto 0.75rem;
  }

  .trust-badges__heading {
    margin: 0 0 0.25rem;
  }

  .trust-badges__text {
    color: rgb(var(--color-foreground), 0.75);
    font-size: 0.9rem;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="trust-badges trust-badges-{{ section.id }} grid grid--1-col grid--3-col-tablet">
      {%- for block in section.blocks -%}
        {%- if block.type == 'badge' -%}
          <div
            class="trust-badges__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <div class="trust-badges__icon">
              {%- if block.settings.icon_image != blank -%}
                <img
                  src="{{ block.settings.icon_image | image_url: width: 80 }}"
                  alt=""
                  width="32"
                  height="32"
                  loading="lazy"
                >
              {%- else -%}
                {%- render 'icon-accordion', icon: block.settings.icon -%}
              {%- endif -%}
            </div>
            {%- if block.settings.heading != blank -%}
              <h3 class="trust-badges__heading h4">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="trust-badges__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Trust bar",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Trust icon",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Truck (shipping)" },
            { "value": "check_mark", "label": "Checkmark (quality)" },
            { "value": "return", "label": "Return" },
            { "value": "lock", "label": "Lock (secure payment)" },
            { "value": "heart", "label": "Heart" },
            { "value": "star", "label": "Star" }
          ],
          "default": "truck"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom icon (optional, replaces the icon above)"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Title",
          "default": "Free Shipping"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>On orders over [PLACEHOLDER — amount]</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        {
          "type": "badge",
          "settings": { "icon": "truck", "heading": "Free Shipping", "text": "<p>On orders over [PLACEHOLDER — amount]</p>" }
        },
        {
          "type": "badge",
          "settings": { "icon": "check_mark", "heading": "Premium Quality", "text": "<p>Carefully chosen materials and finish</p>" }
        },
        {
          "type": "badge",
          "settings": { "icon": "return", "heading": "Easy Returns", "text": "<p>[PLACEHOLDER — days] days to exchange or return</p>" }
        }
      ]
    }
  ]
}
{% endschema %}
