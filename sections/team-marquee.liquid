{% comment %}
  Infinite scrolling team-name ticker, common on motorsport team sites.
  Pure CSS animation, no images or JS required.
{% endcomment %}
{{ 'f1-marquee.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign items = section.settings.text | split: ','
-%}

<div class="f1-marquee" aria-hidden="true">
  <div class="f1-marquee__track" style="animation-duration: {{ section.settings.speed }}s;">
    {%- for i in (1..2) -%}
      <div class="f1-marquee__group">
        {%- for item in items -%}
          <span class="f1-marquee__item">{{ item | strip }}</span>
          <span class="f1-marquee__dot">&bull;</span>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "F1 Team Ticker",
  "tag": "section",
  "class": "section section--marquee",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "text",
      "default": "FERRARI, RED BULL RACING, MERCEDES, MCLAREN, ASTON MARTIN, ALPINE, WILLIAMS, HAAS, RB, ALFA ROMEO",
      "label": "Comma-separated items"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 22,
      "label": "Scroll duration (lower = faster)"
    }
  ],
  "presets": [
    { "name": "F1 Team Ticker" }
  ]
}
{% endschema %}
