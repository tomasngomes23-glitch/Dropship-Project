{% comment %}
  Image-free editorial hero: black canvas, large display type, sparse red
  accent — so the homepage never falls back to Dawn's generic placeholder
  illustration while real photography is pending.
{% endcomment %}
{{ 'f1-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div class="f1-hero color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="f1-hero__content page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="f1-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="f1-hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <div class="f1-hero__subheading rte">{{ section.settings.subheading }}</div>
    {%- endif -%}
    <div class="f1-hero__buttons">
      {%- if section.settings.button_label != blank -%}
        <a
          {% if section.settings.button_link %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
          class="button button--primary"
        >
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
      {%- if section.settings.button_label_2 != blank -%}
        <a
          {% if section.settings.button_link_2 %}
            href="{{ section.settings.button_link_2 }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
          class="button button--secondary"
        >
          {{- section.settings.button_label_2 | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "F1 Hero (no image)",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "default": "OFFICIAL-STYLE TEAM MERCHANDISE",
      "label": "Eyebrow text"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Wear the Grid.",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "default": "<p>Official-style team kits for Ferrari, Red Bull, Mercedes and every grid on the calendar.</p>",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Shop All Kits",
      "label": "Primary button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "default": "Shop Bestsellers",
      "label": "Secondary button label"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-4"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "F1 Hero (no image)"
    }
  ]
}
{% endschema %}
