{{ 'component-rating.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .reviews-{{ section.id }} .reviews__grid {
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .reviews__average {
    text-align: center;
    margin-bottom: 2rem;
  }

  .reviews__average-number {
    font-size: 2.25rem;
    line-height: 1;
  }

  .reviews__card {
    border: 1px solid rgba(var(--color-foreground), 0.1);
    padding: 1.25rem;
  }

  .reviews__card-photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    margin-bottom: 0.75rem;
  }

  .reviews__card-stars {
    color: rgb(var(--color-foreground));
    margin-bottom: 0.5rem;
  }

  .reviews__card-quote {
    font-size: 0.95rem;
    margin: 0 0 0.75rem;
  }

  .reviews__card-author {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: rgb(var(--color-foreground), 0.65);
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding reviews reviews-{{ section.id }}">
    {%- if section.settings.customer_count_heading != blank -%}
      <div class="title-wrapper title-wrapper--no-top-margin center">
        <h2 class="title {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ section.settings.customer_count_heading }}
        </h2>
      </div>
    {%- elsif section.settings.heading != blank -%}
      <div class="title-wrapper title-wrapper--no-top-margin center">
        <h2 class="title {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    {%- if section.settings.show_average -%}
      <div class="reviews__average">
        <p class="reviews__average-number">{{ section.settings.average_rating }} / 5</p>
        <p class="caption">[PLACEHOLDER — based on {{ section.settings.review_count }} real reviews]</p>
      </div>
    {%- endif -%}

    <div class="reviews__grid grid grid--1-col grid--3-col-tablet">
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <div
            class="reviews__card{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.photo != blank -%}
              <img
                class="reviews__card-photo"
                src="{{ block.settings.photo | image_url: width: 500 }}"
                alt="{{ block.settings.photo.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.photo.width }}"
                height="{{ block.settings.photo.height }}"
              >
            {%- endif -%}
            <div class="reviews__card-stars" aria-hidden="true">
              {%- assign stars = block.settings.rating | times: 1 -%}
              {%- for i in (1..5) -%}
                {%- if i <= stars -%}★{%- else -%}☆{%- endif -%}
              {%- endfor -%}
            </div>
            <p class="reviews__card-quote">
              {{ block.settings.quote | default: '[PLACEHOLDER — real customer review, specific to the product]' }}
            </p>
            <p class="reviews__card-author">{{ block.settings.author | default: '[Customer name]' }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Title",
      "default": "What customers say"
    },
    {
      "type": "inline_richtext",
      "id": "customer_count_heading",
      "label": "Title with customer count (replaces the simple title)",
      "default": "[PLACEHOLDER — X+] customers already wear Overtake every day"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Title size",
      "options": [
        { "value": "h2", "label": "Normal" },
        { "value": "h1", "label": "Large" }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "show_average",
      "label": "Show average rating",
      "default": true
    },
    {
      "type": "text",
      "id": "average_rating",
      "label": "Average rating (edit manually or connect a reviews app)",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Number of reviews",
      "default": "0"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 44
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Customer/product photo (optional)"
        },
        {
          "type": "select",
          "id": "rating",
          "label": "Stars",
          "options": [
            { "value": "5", "label": "5" },
            { "value": "4", "label": "4" },
            { "value": "3", "label": "3" }
          ],
          "default": "5"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review text",
          "default": "[PLACEHOLDER — real customer review, specific to the product]"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Customer name",
          "default": "[Customer name]"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
