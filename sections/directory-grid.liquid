{% comment %}
  Matchday Programme "directory" grid — used for Shop by League, Shop by Competition,
  and Retro & Special Editions. Editorial photo-tile system: each entry shows a real
  merchant-uploaded photo full-bleed, with a text label on a scrim at the bottom.
  White/gold theme.
{% endcomment %}

{%- style -%}
  .dg-{{ section.id }} {
    --paper: #fbfaf5; --paper-alt: #f2ede0; --ink: #16140d; --sub: #6b6553;
    --gold: #d9b34d; --gold-bright: #e8c873; --line: #e6e0cf;
    background: var(--paper); color: var(--ink); padding: {{ section.settings.padding_top }}px 1.5rem {{ section.settings.padding_bottom }}px;
    font-family: "Arial Narrow", Arial, sans-serif;
  }
  .dg-{{ section.id }} .dg-head { max-width: 640px; margin: 0 auto 2.5rem; text-align: center; }
  .dg-{{ section.id }} .dg-eyebrow {
    font-family: ui-monospace, "SF Mono", "Cascadia Code", monospace; font-size: 0.7rem;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold); margin-bottom: 0.6rem;
  }
  .dg-{{ section.id }} h2 {
    font-weight: 900; text-transform: uppercase; letter-spacing: -0.01em; line-height: 1;
    font-size: clamp(1.9rem, 4vw, 2.75rem); margin: 0; color: var(--ink);
  }
  .dg-{{ section.id }} .dg-intro { margin-top: 0.75rem; color: var(--sub); font-size: 0.98rem; }
  .dg-{{ section.id }} .dg-grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; max-width: 1200px; margin: 0 auto;
  }
  @media screen and (min-width: 750px) {
    .dg-{{ section.id }} .dg-grid { grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr); }
  }
  .dg-{{ section.id }} .dg-card {
    position: relative; display: block; text-decoration: none; color: var(--ink);
    background: var(--paper-alt); overflow: hidden; aspect-ratio: 3/4;
    border-radius: 14px; border: 1px solid var(--line);
    transform: translateY(var(--dg-lift, 0px)) scale(var(--dg-scale, 1));
    transition: transform 0.25s cubic-bezier(.2,.8,.2,1), box-shadow 0.3s ease, border-color 0.3s ease;
    box-shadow: 0 2px 6px rgba(20,18,12,0.06);
    opacity: 0; translate: 0 22px;
    will-change: transform;
    cursor: pointer;
  }
  .dg-{{ section.id }} .dg-card.is-visible {
    opacity: 1; translate: 0 0; transition: opacity 0.6s ease, translate 0.6s ease, transform 0.25s cubic-bezier(.2,.8,.2,1), box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .dg-{{ section.id }} .dg-card:hover,
  .dg-{{ section.id }} .dg-card.dg-tilting {
    --dg-lift: -6px; --dg-scale: 1.02;
    box-shadow: 0 20px 30px -14px rgba(20,18,12,0.28), 0 0 0 1px var(--gold);
    border-color: var(--gold);
  }
  .dg-{{ section.id }} .dg-card:focus-visible {
    outline: 3px solid var(--gold); outline-offset: 3px;
  }
  /* Merchant photo — fills the tile completely, no padding, no letterboxing */
  .dg-{{ section.id }} .dg-card-photo {
    position: absolute; inset: 0; z-index: 0;
  }
  .dg-{{ section.id }} .dg-card-photo img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform 0.5s ease;
  }
  .dg-{{ section.id }} .dg-card:hover .dg-card-photo img {
    transform: scale(1.06);
  }
  /* Placeholder state when no photo has been uploaded yet — plain warm panel, no icon box */
  .dg-{{ section.id }} .dg-card-photo--empty {
    background: linear-gradient(155deg, var(--paper-alt), #e9e2cd);
  }
  /* Full-bleed country flag — used as the fallback tile background when no merchant photo
     has been uploaded yet. Real per-league identity, drawn in pure CSS gradients (never
     a club/league's trademarked crest — this store is explicitly not affiliated with any
     of them), so it always renders crisp at any size with no image request. */
  .dg-{{ section.id }} .dg-card-flag-bg {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
  }
  .dg-{{ section.id }} .dg-flag--england {
    background-color: #fff;
    background-image:
      linear-gradient(to right, transparent 40%, #ce1124 40%, #ce1124 60%, transparent 60%),
      linear-gradient(to bottom, transparent 40%, #ce1124 40%, #ce1124 60%, transparent 60%);
  }
  .dg-{{ section.id }} .dg-flag--spain {
    background: linear-gradient(to bottom, #c60b1e 0 25%, #ffc400 25% 75%, #c60b1e 75% 100%);
  }
  .dg-{{ section.id }} .dg-flag--italy {
    background: linear-gradient(to right, #008c45 0 33.33%, #f4f5f0 33.33% 66.66%, #cd212a 66.66% 100%);
  }
  .dg-{{ section.id }} .dg-flag--germany {
    background: linear-gradient(to bottom, #000 0 33.33%, #dd0000 33.33% 66.66%, #ffce00 66.66% 100%);
  }
  .dg-{{ section.id }} .dg-flag--france {
    background: linear-gradient(to right, #0055a4 0 33.33%, #fff 33.33% 66.66%, #ef4135 66.66% 100%);
  }
  .dg-{{ section.id }} .dg-flag--portugal {
    background-color: #006600;
    background-image:
      radial-gradient(circle at 40% 50%, #f0c40a 0 9%, #f0c40a 9.3%, transparent 9.6%),
      radial-gradient(circle at 40% 50%, #fff 0 6.5%, transparent 6.8%),
      radial-gradient(circle at 40% 50%, #ff0000 0 4%, transparent 4.3%),
      linear-gradient(to right, transparent 40%, #ff0000 40%, #ff0000 100%);
  }
  .dg-{{ section.id }} .dg-scrim {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 1;
    padding: 2.4rem 1.1rem 1rem;
    background: linear-gradient(to top, rgba(15,13,8,0.82), rgba(15,13,8,0));
  }
  .dg-{{ section.id }} .dg-card-title {
    color: #fbfaf5; font-weight: 900; text-transform: uppercase; letter-spacing: -0.005em;
    font-size: 1.05rem; line-height: 1.18; text-shadow: 0 1px 3px rgba(0,0,0,0.4);
  }
  .dg-{{ section.id }} .dg-card-meta {
    color: var(--gold-bright); font-family: ui-monospace, "SF Mono", "Cascadia Code", monospace;
    font-size: 0.66rem; letter-spacing: 0.08em; text-transform: uppercase; margin-top: 0.3rem;
  }
  .dg-{{ section.id }} .dg-badge {
    position: absolute; z-index: 2; top: 0.85rem; right: 0.85rem; background: var(--gold); color: #fff;
    font-size: 0.62rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;
    padding: 0.3rem 0.6rem; border-radius: 999px;
  }
  @media (prefers-reduced-motion: reduce) {
    .dg-{{ section.id }} .dg-card { transition: none; opacity: 1; translate: 0; transform: none !important; }
    .dg-{{ section.id }} .dg-card:hover, .dg-{{ section.id }} .dg-card.dg-tilting { --dg-lift: 0px; --dg-scale: 1; }
    .dg-{{ section.id }} .dg-card:hover .dg-card-photo img { transform: none; }
  }
{%- endstyle -%}

<div class="dg-{{ section.id }}">
  <div class="dg-head">
    {%- if section.settings.eyebrow != blank -%}<div class="dg-eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.intro != blank -%}<div class="dg-intro">{{ section.settings.intro }}</div>{%- endif -%}
  </div>
  <div class="dg-grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'entry' -%}
        <a href="{{ block.settings.link | default: '#' }}" class="dg-card" data-dg-reveal {{ block.shopify_attributes }}>
          {%- if block.settings.badge != blank -%}<span class="dg-badge">{{ block.settings.badge }}</span>{%- endif -%}
          {%- if block.settings.image != blank -%}
            <span class="dg-card-photo">
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                srcset="{{ block.settings.image | image_url: width: 500 }} 500w, {{ block.settings.image | image_url: width: 800 }} 800w, {{ block.settings.image | image_url: width: 1100 }} 1100w"
                sizes="(min-width: 750px) 25vw, 50vw"
                alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                loading="lazy"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
              >
            </span>
          {%- elsif block.settings.flag_country != blank -%}
            <span class="dg-card-photo dg-card-flag-bg dg-flag--{{ block.settings.flag_country }}" aria-hidden="true"></span>
          {%- else -%}
            <span class="dg-card-photo dg-card-photo--empty" aria-hidden="true"></span>
          {%- endif -%}
          <span class="dg-scrim">
            <span class="dg-card-title">{{ block.settings.title }}</span>
            {%- if block.settings.meta != blank -%}<span class="dg-card-meta">{{ block.settings.meta }}</span>{%- endif -%}
          </span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

<script>
(function () {
  var sections = document.currentScript.previousElementSibling;
  if (!sections) return;
  var cards = sections.querySelectorAll('[data-dg-reveal]');
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduce || !('IntersectionObserver' in window)) {
    cards.forEach(function (c) { c.classList.add('is-visible'); });
    return;
  }
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        var el = entry.target;
        var delay = (Array.prototype.indexOf.call(cards, el) % 6) * 70;
        setTimeout(function () { el.classList.add('is-visible'); }, delay);
        io.unobserve(el);
      }
    });
  }, { threshold: 0.15 });
  cards.forEach(function (c) { io.observe(c); });
  /* Safety net: force visible after a short delay in case the observer never fires
     (e.g. theme editor preview iframes). Content must never stay permanently hidden. */
  setTimeout(function () {
    cards.forEach(function (c) { c.classList.add('is-visible'); });
  }, 1200);

  // 3D tilt-on-mousemove — trading-card style, disabled under reduced-motion or on touch.
  var supportsHover = window.matchMedia && window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  if (!reduce && supportsHover) {
    var MAX_TILT = 6;
    cards.forEach(function (card) {
      card.addEventListener('mousemove', function (e) {
        var rect = card.getBoundingClientRect();
        var x = (e.clientX - rect.left) / rect.width;
        var y = (e.clientY - rect.top) / rect.height;
        var tiltY = (x - 0.5) * (MAX_TILT * 2);
        var tiltX = (0.5 - y) * (MAX_TILT * 2);
        card.style.setProperty('--dg-tilt-x', tiltX.toFixed(2) + 'deg');
        card.style.setProperty('--dg-tilt-y', tiltY.toFixed(2) + 'deg');
        card.classList.add('dg-tilting');
      });
      card.addEventListener('mouseleave', function () {
        card.style.setProperty('--dg-tilt-x', '0deg');
        card.style.setProperty('--dg-tilt-y', '0deg');
        card.classList.remove('dg-tilting');
      });
    });
  }
})();
</script>

{% schema %}
{
  "name": "Directory grid (Matchday)",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Directory" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by league" },
    { "type": "richtext", "id": "intro", "label": "Intro text" },
    { "type": "range", "id": "columns_desktop", "label": "Desktop columns", "min": 3, "max": 6, "step": 1, "default": 6 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "entry",
      "name": "Entry",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Premier League" },
        { "type": "text", "id": "meta", "label": "Meta line", "default": "In stock" },
        { "type": "text", "id": "badge", "label": "Badge (optional)" },
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "Upload your own photo for this collection tile" },
        {
          "type": "select",
          "id": "flag_country",
          "label": "Country flag background (used if no photo is set)",
          "info": "Leave as None for international competitions",
          "options": [
            { "value": "", "label": "None" },
            { "value": "england", "label": "England" },
            { "value": "spain", "label": "Spain" },
            { "value": "italy", "label": "Italy" },
            { "value": "germany", "label": "Germany" },
            { "value": "france", "label": "France" },
            { "value": "portugal", "label": "Portugal" }
          ],
          "default": ""
        },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Directory grid (Matchday)",
      "blocks": [
        { "type": "entry", "settings": { "title": "Premier League", "meta": "In stock" } },
        { "type": "entry", "settings": { "title": "La Liga", "meta": "In stock" } },
        { "type": "entry", "settings": { "title": "Serie A", "meta": "In stock" } },
        { "type": "entry", "settings": { "title": "Bundesliga", "meta": "In stock" } },
        { "type": "entry", "settings": { "title": "Ligue 1", "meta": "In stock" } },
        { "type": "entry", "settings": { "title": "Primeira Liga", "meta": "In stock" } }
      ]
    }
  ]
}
{% endschema %}
