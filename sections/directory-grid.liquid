{% comment %}
  Matchday Programme "directory" grid — used for Shop by League, Shop by Competition,
  and Retro & Special Editions. One shared component so all three read as one system:
  ticket-stub / sticker cards instead of a generic image grid.
{% endcomment %}

{%- style -%}
  .dg-{{ section.id }} {
    --pitch: #0d1f16; --pitch-dark: #081511; --paper: #f2ede1; --ink: #14120c;
    --chalk: #f5f1e6; --gold: #c9962f; --gold-bright: #e0b355; --live-green: #3ea65f;
    background: var(--pitch); color: var(--chalk); padding: {{ section.settings.padding_top }}px 1.5rem {{ section.settings.padding_bottom }}px;
    background-image: radial-gradient(circle, rgba(245,241,230,0.05) 1px, transparent 1.1px);
    background-size: 9px 9px; font-family: "Arial Narrow", Arial, sans-serif;
  }
  .dg-{{ section.id }} .dg-head { max-width: 640px; margin: 0 auto 2.5rem; text-align: center; }
  .dg-{{ section.id }} .dg-eyebrow {
    font-family: ui-monospace, "SF Mono", "Cascadia Code", monospace; font-size: 0.7rem;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold-bright); margin-bottom: 0.6rem;
  }
  .dg-{{ section.id }} h2 {
    font-weight: 900; text-transform: uppercase; letter-spacing: -0.01em; line-height: 1;
    font-size: clamp(1.9rem, 4vw, 2.75rem); margin: 0; color: var(--chalk);
  }
  .dg-{{ section.id }} .dg-intro { margin-top: 0.75rem; color: rgba(245,241,230,0.78); font-size: 0.98rem; }
  .dg-{{ section.id }} .dg-grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; max-width: 1200px; margin: 0 auto;
  }
  @media screen and (min-width: 750px) {
    .dg-{{ section.id }} .dg-grid { grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr); }
  }
  .dg-{{ section.id }} .dg-card {
    position: relative; display: block; text-decoration: none; color: var(--ink); background: var(--paper);
    padding: 2.4rem 1.1rem 1.3rem; text-align: center; overflow: hidden;
    clip-path: polygon(0% 6%, 6% 0%, 94% 0%, 100% 6%, 100% 94%, 94% 100%, 6% 100%, 0% 94%);
    transform: perspective(900px) rotateX(var(--dg-tilt-x, 0deg)) rotateY(var(--dg-tilt-y, 0deg)) translateY(var(--dg-lift, 0px)) scale(var(--dg-scale, 1));
    transition: transform 0.15s ease-out, box-shadow 0.3s ease, border-color 0.3s ease;
    box-shadow: 0 6px 0 rgba(0,0,0,0.28);
    opacity: 0; translate: 0 22px;
    border: 2px solid transparent;
    will-change: transform;
    cursor: pointer;
  }
  /* Faint knit/fabric texture — reads as jersey material instead of flat paper */
  .dg-{{ section.id }} .dg-card::before {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background-image: repeating-linear-gradient(45deg, rgba(20,18,12,0.035) 0 2px, transparent 2px 6px);
  }
  /* Giant ghost-monogram behind the title, like a stadium programme's oversized
     initials treatment — derived from the entry title, no extra data entry needed.
     Sits behind the title (declared first in markup, painted after ::before). */
  .dg-{{ section.id }} .dg-card-mono {
    position: absolute; right: -0.3rem; bottom: -0.9rem; z-index: 0;
    font-family: "Arial Black", "Arial Narrow", Arial, sans-serif; font-weight: 900;
    font-size: 4.6rem; line-height: 1; color: var(--ink); opacity: 0.055;
    letter-spacing: -0.04em; pointer-events: none; user-select: none;
    transition: opacity 0.3s ease, color 0.3s ease;
  }
  .dg-{{ section.id }} .dg-card:hover .dg-card-mono,
  .dg-{{ section.id }} .dg-card.dg-tilting .dg-card-mono {
    opacity: 0.16; color: var(--gold);
  }
  /* Squad-number badge replacing the flat "No. 01" caption — a jersey-number tag
     pinned to the corner instead of inline text. */
  .dg-{{ section.id }} .dg-card-num {
    position: absolute; top: 0.85rem; left: 0.85rem; z-index: 1;
    width: 1.9rem; height: 1.9rem; border-radius: 50%;
    border: 2px solid var(--gold); background: var(--paper);
    display: flex; align-items: center; justify-content: center;
    font-family: ui-monospace, "SF Mono", "Cascadia Code", monospace;
    font-size: 0.7rem; font-weight: 700; color: var(--ink);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .dg-{{ section.id }} .dg-card:hover .dg-card-num,
  .dg-{{ section.id }} .dg-card.dg-tilting .dg-card-num {
    border-color: var(--gold-bright); transform: scale(1.08) rotate(-6deg);
  }
  .dg-{{ section.id }} .dg-card-title,
  .dg-{{ section.id }} .dg-card-meta {
    position: relative; z-index: 1;
  }
  .dg-{{ section.id }} .dg-card.is-visible {
    opacity: 1; translate: 0 0; transition: opacity 0.6s ease, translate 0.6s ease, transform 0.15s ease-out, box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .dg-{{ section.id }} .dg-card:hover,
  .dg-{{ section.id }} .dg-card.dg-tilting {
    --dg-lift: -8px; --dg-scale: 1.045;
    box-shadow: 0 22px 34px -12px rgba(0,0,0,0.45), 0 0 0 1px rgba(201,150,47,0.25),
      0 14px 0 rgba(0,0,0,0.3), 0 0 30px rgba(224,179,85,0.4);
    border-color: rgba(201,150,47,0.8);
  }
  .dg-{{ section.id }} .dg-card:active {
    --dg-lift: -3px; --dg-scale: 1.01;
  }
  .dg-{{ section.id }} .dg-card:focus-visible {
    outline: 3px solid var(--gold-bright); outline-offset: 3px;
  }
  .dg-{{ section.id }} .dg-card-title {
    font-weight: 900; text-transform: uppercase; letter-spacing: -0.005em; font-size: 1.1rem; line-height: 1.15;
  }
  .dg-{{ section.id }} .dg-card-meta {
    margin-top: 0.5rem; font-size: 0.78rem; opacity: 0.7; display: flex; align-items: center; justify-content: center; gap: 0.4rem;
  }
  .dg-{{ section.id }} .dg-dot {
    width: 6px; height: 6px; border-radius: 50%; background: var(--live-green); display: inline-block; flex: none;
  }
  /* Hex/ball-panel badge — classic football stitching look instead of a flat sticker */
  .dg-{{ section.id }} .dg-badge {
    position: absolute; top: -0.6rem; right: -0.5rem; background: var(--gold); color: var(--ink);
    font-size: 0.62rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;
    padding: 0.3rem 0.55rem; transform: rotate(6deg);
    clip-path: polygon(0% 12%, 10% 0%, 90% 0%, 100% 12%, 100% 88%, 90% 100%, 10% 100%, 0% 88%);
    background-image:
      linear-gradient(30deg, rgba(20,18,12,0.16) 12%, transparent 12.5%, transparent 87%, rgba(20,18,12,0.16) 87.5%, rgba(20,18,12,0.16)),
      linear-gradient(150deg, rgba(20,18,12,0.16) 12%, transparent 12.5%, transparent 87%, rgba(20,18,12,0.16) 87.5%, rgba(20,18,12,0.16)),
      linear-gradient(30deg, rgba(20,18,12,0.16) 12%, transparent 12.5%, transparent 87%, rgba(20,18,12,0.16) 87.5%, rgba(20,18,12,0.16)),
      linear-gradient(150deg, rgba(20,18,12,0.16) 12%, transparent 12.5%, transparent 87%, rgba(20,18,12,0.16) 87.5%, rgba(20,18,12,0.16)),
      linear-gradient(60deg, rgba(20,18,12,0.1) 25%, transparent 25.5%, transparent 75%, rgba(20,18,12,0.1) 75%, rgba(20,18,12,0.1)),
      linear-gradient(60deg, rgba(20,18,12,0.1) 25%, transparent 25.5%, transparent 75%, rgba(20,18,12,0.1) 75%, rgba(20,18,12,0.1));
    background-size: 9px 16px;
    background-position: 0 0, 0 0, 4.5px 8px, 4.5px 8px, 0 0, 4.5px 8px;
  }
  @media (prefers-reduced-motion: reduce) {
    .dg-{{ section.id }} .dg-card { transition: none; opacity: 1; translate: 0; transform: none !important; }
    .dg-{{ section.id }} .dg-card:hover, .dg-{{ section.id }} .dg-card.dg-tilting { --dg-lift: 0px; --dg-scale: 1; }
  }
{%- endstyle -%}

<div class="dg-{{ section.id }}">
  <div class="dg-head">
    {%- if section.settings.eyebrow != blank -%}<div class="dg-eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.intro != blank -%}<div class="dg-intro">{{ section.settings.intro }}</div>{%- endif -%}
  </div>
  <div class="dg-grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'entry' -%}
        {%- liquid
          assign dg_words = block.settings.title | split: ' '
          assign dg_initials = ''
          for dg_word in dg_words limit: 2
            assign dg_initials = dg_initials | append: dg_word | slice: 0, 1
          endfor
        -%}
        <a href="{{ block.settings.link | default: '#' }}" class="dg-card" data-dg-reveal {{ block.shopify_attributes }}>
          {%- if block.settings.badge != blank -%}<span class="dg-badge">{{ block.settings.badge }}</span>{%- endif -%}
          <div class="dg-card-mono" aria-hidden="true">{{ dg_initials }}</div>
          <div class="dg-card-num">{{ forloop.index | prepend: '00' | slice: -2, 2 }}</div>
          <div class="dg-card-title">{{ block.settings.title }}</div>
          {%- if block.settings.meta != blank -%}
            <div class="dg-card-meta"><span class="dg-dot" aria-hidden="true"></span>{{ block.settings.meta }}</div>
          {%- endif -%}
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

<script>
(function () {
  var sections = document.currentScript.previousElementSibling;
  if (!sections) return;
  var cards = sections.querySelectorAll('[data-dg-reveal]');
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduce || !('IntersectionObserver' in window)) {
    cards.forEach(function (c) { c.classList.add('is-visible'); });
    return;
  }
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        var el = entry.target;
        var delay = (Array.prototype.indexOf.call(cards, el) % 6) * 70;
        setTimeout(function () { el.classList.add('is-visible'); }, delay);
        io.unobserve(el);
      }
    });
  }, { threshold: 0.15 });
  cards.forEach(function (c) { io.observe(c); });
  /* Safety net: force visible after a short delay in case the observer never fires
     (e.g. theme editor preview iframes). Content must never stay permanently hidden. */
  setTimeout(function () {
    cards.forEach(function (c) { c.classList.add('is-visible'); });
  }, 1200);

  // 3D tilt-on-mousemove — trading-card style, disabled under reduced-motion or on touch.
  var supportsHover = window.matchMedia && window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  if (!reduce && supportsHover) {
    var MAX_TILT = 10;
    cards.forEach(function (card) {
      card.addEventListener('mousemove', function (e) {
        var rect = card.getBoundingClientRect();
        var x = (e.clientX - rect.left) / rect.width;
        var y = (e.clientY - rect.top) / rect.height;
        var tiltY = (x - 0.5) * (MAX_TILT * 2);
        var tiltX = (0.5 - y) * (MAX_TILT * 2);
        card.style.setProperty('--dg-tilt-x', tiltX.toFixed(2) + 'deg');
        card.style.setProperty('--dg-tilt-y', tiltY.toFixed(2) + 'deg');
        card.classList.add('dg-tilting');
      });
      card.addEventListener('mouseleave', function () {
        card.style.setProperty('--dg-tilt-x', '0deg');
        card.style.setProperty('--dg-tilt-y', '0deg');
        card.classList.remove('dg-tilting');
      });
    });
  }
})();
</script>

{% schema %}
{
  "name": "Directory grid (Matchday)",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Directory" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by league" },
    { "type": "richtext", "id": "intro", "label": "Intro text" },
    { "type": "range", "id": "columns_desktop", "label": "Desktop columns", "min": 3, "max": 6, "step": 1, "default": 6 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "entry",
      "name": "Entry",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Premier League" },
        { "type": "text", "id": "meta", "label": "Meta line", "default": "In stock" },
        { "type": "text", "id": "badge", "label": "Badge (optional)" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Directory grid (Matchday)",
      "blocks": [
        { "type": "entry", "settings": { "title": "Premier League", "meta": "In stock" } },
        { "type": "entry", "settings": { "title": "La Liga", "meta": "In stock" } },
        { "type": "entry", "settings": { "title": "Serie A", "meta": "In stock" } },
        { "type": "entry", "settings": { "title": "Bundesliga", "meta": "In stock" } },
        { "type": "entry", "settings": { "title": "Ligue 1", "meta": "In stock" } },
        { "type": "entry", "settings": { "title": "Primeira Liga", "meta": "In stock" } }
      ]
    }
  ]
}
{% endschema %}
