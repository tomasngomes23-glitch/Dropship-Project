{%- style -%}
  .size-guide-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  .size-guide-{{ section.id }} table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 2rem;
  }
  .size-guide-{{ section.id }} th,
  .size-guide-{{ section.id }} td {
    text-align: center;
    padding: 0.9rem 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }
  .size-guide-{{ section.id }} th:first-child,
  .size-guide-{{ section.id }} td:first-child {
    text-align: left;
  }
  .size-guide-{{ section.id }} .size-guide-note {
    margin-top: 1.5rem;
    opacity: 0.75;
    font-size: 0.9rem;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width size-guide-{{ section.id }}">
    <h1 class="{{ section.settings.heading_size }}">{{ section.settings.heading }}</h1>
    {%- if section.settings.intro != blank -%}
      <div class="rte">{{ section.settings.intro }}</div>
    {%- endif -%}

    <table>
      <thead>
        <tr>
          <th>Size</th>
          <th>Chest (cm)</th>
          <th>Length (cm)</th>
          <th>Age / fit guide</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>S</td><td>90–95</td><td>68</td><td>Slim adult fit</td></tr>
        <tr><td>M</td><td>96–101</td><td>70</td><td>Standard adult fit</td></tr>
        <tr><td>L</td><td>102–107</td><td>72</td><td>Standard adult fit</td></tr>
        <tr><td>XL</td><td>108–113</td><td>74</td><td>Standard adult fit</td></tr>
        <tr><td>XXL</td><td>114–119</td><td>76</td><td>Loose adult fit</td></tr>
      </tbody>
    </table>

    <p class="size-guide-note">
      Measurements are garment measurements, not body measurements — lay the shirt flat and
      measure chest pit-to-pit ×2, and length from shoulder seam to hem. Most replica-cut kits
      run slightly slimmer than casual t-shirts — if you're between sizes, size up for a
      comfortable everyday fit.
    </p>
  </div>
</div>

{% schema %}
{
  "name": "Size guide",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Size guide"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h1", "label": "Large" },
        { "value": "h0", "label": "Extra large" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "default": "<p>Not sure which size to grab? Use the chart below.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 52
    }
  ],
  "presets": [
    { "name": "Size guide" }
  ]
}
{% endschema %}
