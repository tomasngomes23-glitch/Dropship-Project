{%- style -%}
  .sg-{{ section.id }} {
    --pitch: #0d1f16; --pitch-dark: #081511; --paper: #f2ede1; --ink: #14120c;
    --chalk: #f5f1e6; --gold: #c9962f; --gold-bright: #e0b355; --live-green: #3ea65f;
    background: var(--pitch); color: var(--chalk); font-family: "Arial Narrow", Arial, sans-serif;
    padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;
    background-image: radial-gradient(circle, rgba(245,241,230,0.05) 1px, transparent 1.1px); background-size: 9px 9px;
  }
  .sg-{{ section.id }} h1 { font-weight: 900; text-transform: uppercase; letter-spacing: -0.01em; }
  .sg-{{ section.id }} .sg-wrap { display: grid; grid-template-columns: 1fr; gap: 2.5rem; max-width: 760px; margin: 2.5rem auto 0; background: var(--paper); color: var(--ink); padding: 2rem; clip-path: polygon(0% 2%, 2% 0%, 98% 0%, 100% 2%, 100% 98%, 98% 100%, 2% 100%, 0% 98%); }
  @media screen and (min-width: 750px) { .sg-{{ section.id }} .sg-wrap { grid-template-columns: 1fr 1fr; align-items: center; } }
  .sg-{{ section.id }} .sg-tabs { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; margin-bottom: 1.5rem; }
  .sg-{{ section.id }} .sg-tab { border: 1px dashed rgba(20,18,12,0.35); background: transparent; color: var(--ink); padding: 0.55rem 1.1rem; cursor: pointer; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; transition: all 0.25s ease; clip-path: polygon(0% 15%, 10% 0%, 90% 0%, 100% 15%, 100% 85%, 90% 100%, 10% 100%, 0% 85%); }
  .sg-{{ section.id }} .sg-tab:hover { border-color: var(--gold); transform: translateY(-2px); }
  .sg-{{ section.id }} .sg-tab.is-active { background: var(--gold); color: var(--ink); border-color: transparent; border-style: solid; }
  .sg-{{ section.id }} .sg-figure { position: relative; display: flex; align-items: center; justify-content: center; }
  .sg-{{ section.id }} svg { width: 100%; max-width: 340px; height: auto; overflow: visible; }
  .sg-{{ section.id }} .sg-shirt { fill: rgba(20,18,12,0.05); stroke: rgba(20,18,12,0.45); stroke-width: 2; transition: d 0.4s ease; }
  .sg-{{ section.id }} .sg-dim-line { stroke: var(--gold); stroke-width: 2; transition: all 0.5s cubic-bezier(.4,0,.2,1); }
  .sg-{{ section.id }} .sg-dim-cap { stroke: var(--gold); stroke-width: 2; transition: all 0.5s cubic-bezier(.4,0,.2,1); }
  .sg-{{ section.id }} .sg-dim-label { fill: var(--gold); font-size: 13px; font-weight: 700; transition: all 0.5s cubic-bezier(.4,0,.2,1); }
  .sg-{{ section.id }} .sg-readout { display: flex; gap: 1.5rem; justify-content: center; margin-top: 1rem; }
  .sg-{{ section.id }} .sg-stat { text-align: center; }
  .sg-{{ section.id }} .sg-stat-num { font-family: ui-monospace, "SF Mono", "Cascadia Code", monospace; font-size: 2.1rem; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }
  .sg-{{ section.id }} .sg-stat-label { font-size: 0.75rem; opacity: 0.6; text-transform: uppercase; letter-spacing: 0.08em; margin-top: 0.35rem; }
  .sg-{{ section.id }} .sg-fit-tag { text-align: center; margin-top: 0.75rem; font-size: 0.95rem; opacity: 0.85; min-height: 1.4em; }
  .sg-{{ section.id }} details { margin-top: 2.5rem; border-top: 1px dashed rgba(20,18,12,0.3); padding-top: 1.25rem; }
  .sg-{{ section.id }} summary { cursor: pointer; font-weight: 700; text-transform: uppercase; }
  .sg-{{ section.id }} table { width: 100%; border-collapse: collapse; margin-top: 1rem; font-size: 0.9rem; font-family: ui-monospace, "SF Mono", "Cascadia Code", monospace; }
  .sg-{{ section.id }} th, .sg-{{ section.id }} td { text-align: center; padding: 0.6rem 0.4rem; border: 1px dashed rgba(20,18,12,0.25); }
  .sg-{{ section.id }} th:first-child, .sg-{{ section.id }} td:first-child { text-align: left; }
  .sg-{{ section.id }} .sg-note { margin-top: 1.5rem; opacity: 0.75; font-size: 0.88rem; text-align: center; }
  @keyframes sg-pop { 0% { transform: scale(0.85); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }
  .sg-{{ section.id }} .sg-pop { animation: sg-pop 0.35s ease; }
  @media (prefers-reduced-motion: reduce) { .sg-{{ section.id }} .sg-pop { animation: none; } }
{%- endstyle -%}

<div class="sg-{{ section.id }}">
  <div class="page-width">
    <h1 class="{{ section.settings.heading_size }}" style="text-align:center;">{{ section.settings.heading }}</h1>
    {%- if section.settings.intro != blank -%}
      <div class="rte" style="text-align:center; max-width:520px; margin:0.75rem auto 0;">{{ section.settings.intro }}</div>
    {%- endif -%}

    <div class="sg-tabs" role="tablist" aria-label="Select a size">
      <button type="button" class="sg-tab" data-size="S">S</button>
      <button type="button" class="sg-tab" data-size="M">M</button>
      <button type="button" class="sg-tab is-active" data-size="L">L</button>
      <button type="button" class="sg-tab" data-size="XL">XL</button>
      <button type="button" class="sg-tab" data-size="XXL">XXL</button>
    </div>

    <div class="sg-wrap">
      <div class="sg-figure">
        <svg viewBox="0 0 240 260" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path class="sg-shirt" d="M70 20 L95 5 Q120 20 145 5 L170 20 L210 55 L188 85 L170 72 L170 235 Q120 245 70 235 L70 72 L52 85 L30 55 Z"/>
          <line class="sg-dim-line" data-dim="chest" x1="70" y1="110" x2="170" y2="110"/>
          <line class="sg-dim-cap" data-dim="chest" x1="70" y1="104" x2="70" y2="116"/>
          <line class="sg-dim-cap" data-dim="chest" x1="170" y1="104" x2="170" y2="116"/>
          <text class="sg-dim-label" data-dim="chest" x="120" y="100" text-anchor="middle">chest</text>
          <line class="sg-dim-line" data-dim="length" x1="196" y1="55" x2="196" y2="235"/>
          <line class="sg-dim-cap" data-dim="length" x1="190" y1="55" x2="202" y2="55"/>
          <line class="sg-dim-cap" data-dim="length" x1="190" y1="235" x2="202" y2="235"/>
          <text class="sg-dim-label" data-dim="length" x="224" y="148" text-anchor="middle" transform="rotate(90 224 148)">length</text>
        </svg>
      </div>
      <div>
        <div class="sg-readout">
          <div class="sg-stat">
            <div class="sg-stat-num" id="sg-chest-{{ section.id }}">102–107</div>
            <div class="sg-stat-label">Chest, cm</div>
          </div>
          <div class="sg-stat">
            <div class="sg-stat-num" id="sg-length-{{ section.id }}">72</div>
            <div class="sg-stat-label">Length, cm</div>
          </div>
        </div>
        <div class="sg-fit-tag" id="sg-fit-{{ section.id }}">Standard adult fit</div>
      </div>
    </div>

    <p class="sg-note">
      Measurements are garment measurements, not body measurements — lay the shirt flat and
      measure chest pit-to-pit ×2, and length from shoulder seam to hem. Most replica-cut kits
      run slightly slimmer than casual t-shirts — if you're between sizes, size up for a
      comfortable everyday fit.
    </p>

    <details>
      <summary>View full size chart</summary>
      <table>
        <thead><tr><th>Size</th><th>Chest (cm)</th><th>Length (cm)</th><th>Fit</th></tr></thead>
        <tbody>
          <tr><td>S</td><td>90–95</td><td>68</td><td>Slim adult fit</td></tr>
          <tr><td>M</td><td>96–101</td><td>70</td><td>Standard adult fit</td></tr>
          <tr><td>L</td><td>102–107</td><td>72</td><td>Standard adult fit</td></tr>
          <tr><td>XL</td><td>108–113</td><td>74</td><td>Standard adult fit</td></tr>
          <tr><td>XXL</td><td>114–119</td><td>76</td><td>Loose adult fit</td></tr>
        </tbody>
      </table>
    </details>
  </div>
</div>

<script>
(function() {
  var root = document.currentScript.closest('.sg-{{ section.id }}') || document.querySelector('.sg-{{ section.id }}');
  if (!root) return;
  var data = {
    S:   { chest: '90–95',   chestPx: 55, length: 68, lengthY1: 65, lengthY2: 210, fit: 'Slim adult fit' },
    M:   { chest: '96–101',  chestPx: 62, length: 70, lengthY1: 60, lengthY2: 222, fit: 'Standard adult fit' },
    L:   { chest: '102–107', chestPx: 70, length: 72, lengthY1: 55, lengthY2: 235, fit: 'Standard adult fit' },
    XL:  { chest: '108–113', chestPx: 78, length: 74, lengthY1: 50, lengthY2: 246, fit: 'Standard adult fit' },
    XXL: { chest: '114–119', chestPx: 85, length: 76, lengthY1: 45, lengthY2: 258, fit: 'Loose adult fit' }
  };
  var svg = root.querySelector('svg');
  var chestLine = svg.querySelector('line.sg-dim-line[data-dim="chest"]');
  var chestCaps = svg.querySelectorAll('line.sg-dim-cap[data-dim="chest"]');
  var lengthLine = svg.querySelector('line.sg-dim-line[data-dim="length"]');
  var lengthCaps = svg.querySelectorAll('line.sg-dim-cap[data-dim="length"]');
  var chestNum = root.querySelector('#sg-chest-{{ section.id }}');
  var lengthNum = root.querySelector('#sg-length-{{ section.id }}');
  var fitTag = root.querySelector('#sg-fit-{{ section.id }}');
  var tabs = root.querySelectorAll('.sg-tab');

  function apply(size) {
    var d = data[size];
    if (!d) return;
    var half = d.chestPx / 2;
    var cx = 120;
    chestLine.setAttribute('x1', cx - half);
    chestLine.setAttribute('x2', cx + half);
    chestCaps[0].setAttribute('x1', cx - half); chestCaps[0].setAttribute('x2', cx - half);
    chestCaps[1].setAttribute('x1', cx + half); chestCaps[1].setAttribute('x2', cx + half);
    lengthLine.setAttribute('y1', d.lengthY1); lengthLine.setAttribute('y2', d.lengthY2);
    lengthCaps[0].setAttribute('y1', d.lengthY1); lengthCaps[0].setAttribute('y2', d.lengthY1);
    lengthCaps[1].setAttribute('y1', d.lengthY2); lengthCaps[1].setAttribute('y2', d.lengthY2);
    chestNum.textContent = d.chest;
    lengthNum.textContent = d.length;
    fitTag.textContent = d.fit;
    [chestNum, lengthNum, fitTag].forEach(function(el) {
      el.classList.remove('sg-pop');
      void el.offsetWidth;
      el.classList.add('sg-pop');
    });
    tabs.forEach(function(t) { t.classList.toggle('is-active', t.dataset.size === size); });
  }

  tabs.forEach(function(tab) {
    tab.addEventListener('click', function() { apply(tab.dataset.size); });
  });
})();
</script>

{% schema %}
{
  "name": "Size guide",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Size guide" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "options": [ { "value": "h1", "label": "Large" }, { "value": "h0", "label": "Extra large" } ], "default": "h1" },
    { "type": "richtext", "id": "intro", "label": "Intro text", "default": "<p>Tap a size to see it come to life.</p>" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 52 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 52 }
  ],
  "presets": [ { "name": "Size guide" } ]
}
{% endschema %}
