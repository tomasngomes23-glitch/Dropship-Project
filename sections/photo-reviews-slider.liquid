{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #photo-reviews-{{ section.id }} .photo-reviews__heading {
    text-align: left;
    font-weight: 800;
    margin: 0;
  }

  #photo-reviews-{{ section.id }} .photo-reviews__title-wrapper {
    margin: 0 0 2.5rem;
    padding-left: 2rem;
    padding-right: 2rem;
  }

  @media screen and (min-width: 750px) {
    #photo-reviews-{{ section.id }} .photo-reviews__title-wrapper {
      padding-left: 4.5rem;
      padding-right: 4.5rem;
    }
  }

  #photo-reviews-{{ section.id }} .photo-reviews__viewport {
    overflow: hidden;
    width: 100%;
    padding: 1.5rem 0;
  }

  #photo-reviews-{{ section.id }} .photo-reviews__track {
    display: flex;
    align-items: stretch;
    gap: 1.25rem;
    width: max-content;
    animation: photo-reviews-scroll-{{ section.id }} {{ section.settings.speed }}s linear infinite;
    will-change: transform;
  }

  #photo-reviews-{{ section.id }}:hover .photo-reviews__track {
    animation-play-state: {% if section.settings.pause_on_hover %}paused{% else %}running{% endif %};
  }

  @keyframes photo-reviews-scroll-{{ section.id }} {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  #photo-reviews-{{ section.id }} .photo-reviews__card {
    background: rgb(var(--color-background));
    border: 1px solid rgba(217, 33, 51, 0.25);
    border-radius: 12px;
    box-shadow: 0 0 18px rgba(217, 33, 51, 0.16);
    padding: 1rem;
    width: clamp(160px, 16vw, 200px);
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
  }

  #photo-reviews-{{ section.id }} .photo-reviews__image-wrapper {
    aspect-ratio: 1 / 1;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 0.85rem;
    background: rgba(var(--color-foreground), 0.06);
  }

  #photo-reviews-{{ section.id }} .photo-reviews__image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #photo-reviews-{{ section.id }} .photo-reviews__stars {
    color: #d92133;
    letter-spacing: 0.08em;
    margin-bottom: 0.6rem;
    font-size: 1rem;
  }

  #photo-reviews-{{ section.id }} .photo-reviews__title {
    font-weight: 800;
    font-size: 0.95rem;
    margin: 0 0 0.35rem;
  }

  #photo-reviews-{{ section.id }} .photo-reviews__quote {
    font-style: normal;
    font-size: 0.8rem;
    line-height: 1.45;
    margin: 0 0 0.75rem;
    flex-grow: 1;
    color: rgba(var(--color-foreground), 0.8);
  }

  #photo-reviews-{{ section.id }} .photo-reviews__author {
    font-weight: 700;
    font-size: 0.78rem;
  }

  @media (prefers-reduced-motion: reduce) {
    #photo-reviews-{{ section.id }} .photo-reviews__track {
      animation: none;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="section-{{ section.id }}-padding" id="photo-reviews-{{ section.id }}">
    {%- if section.settings.heading != blank -%}
      <div class="photo-reviews__title-wrapper title-wrapper title-wrapper--no-top-margin page-width">
        <h2 class="photo-reviews__heading title {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="photo-reviews__viewport">
      <div class="photo-reviews__track">
        {%- for dup in (1..2) -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'review_card' -%}
              <div class="photo-reviews__card" {% if dup == 1 %}{{ block.shopify_attributes }}{% endif %} {% if dup > 1 %}aria-hidden="true"{% endif %}>
                <div class="photo-reviews__image-wrapper">
                  {%- if block.settings.image != blank -%}
                    <img
                      src="{{ block.settings.image | image_url: width: 400 }}"
                      alt="{{ block.settings.image.alt | escape }}"
                      loading="lazy"
                      width="{{ block.settings.image.width }}"
                      height="{{ block.settings.image.height }}"
                    >
                  {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
                <div class="photo-reviews__stars" aria-hidden="true">
                  {%- assign stars = block.settings.rating | times: 1 -%}
                  {%- for star_i in (1..5) -%}
                    {%- if star_i <= stars -%}★{%- else -%}☆{%- endif -%}
                  {%- endfor -%}
                </div>
                {%- if block.settings.title != blank -%}
                  <p class="photo-reviews__title">{{ block.settings.title }}</p>
                {%- endif -%}
                <p class="photo-reviews__quote">
                  {{ block.settings.quote | default: '[PLACEHOLDER — review real de cliente]' }}
                </p>
                <p class="photo-reviews__author">{{ block.settings.author | default: '[Nome do cliente]' }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Reviews com fotos",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "12.000+ clientes já vestem Overtake"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamanho do título",
      "options": [
        { "value": "h2", "label": "Normal" },
        { "value": "h1", "label": "Grande" }
      ],
      "default": "h1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de cor",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Movimento"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Velocidade (segundos por ciclo — menor é mais rápido)",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pausar ao passar o rato por cima",
      "default": true
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaço acima",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaço abaixo",
      "default": 44
    }
  ],
  "blocks": [
    {
      "type": "review_card",
      "name": "Review com foto",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto do cliente/produto"
        },
        {
          "type": "select",
          "id": "rating",
          "label": "Estrelas",
          "options": [
            { "value": "5", "label": "5" },
            { "value": "4", "label": "4" },
            { "value": "3", "label": "3" }
          ],
          "default": "5"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título da review",
          "default": "[PLACEHOLDER — título curto]"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Texto da review",
          "default": "[PLACEHOLDER — review real de cliente]"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Nome do cliente",
          "default": "[Nome do cliente]"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews com fotos",
      "blocks": [
        { "type": "review_card" },
        { "type": "review_card" },
        { "type": "review_card" },
        { "type": "review_card" },
        { "type": "review_card" }
      ]
    }
  ]
}
{% endschema %}
