{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .comparison-{{ section.id }} .comparison__top {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 1.5rem;
  }

  .comparison__heading {
    font-weight: 800;
    letter-spacing: -0.01em;
    margin: 0 0 1.25rem;
    font-size: 3rem !important;
  }

  @media screen and (min-width: 750px) {
    .comparison__heading {
      font-size: 4rem !important;
    }
  }

  .comparison__subheading {
    font-size: 1.7rem;
    color: rgba(var(--color-foreground), 0.65);
    margin: 0;
  }

  .comparison__hint {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin: 0 auto 2.5rem;
    max-width: 1120px;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: rgba(var(--color-foreground), 0.45);
  }

  .comparison__hint svg {
    width: 1.4rem;
    height: 1.4rem;
    stroke: currentColor;
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .comparison__hint .comparison__hint-arrow--left {
    animation: comparison-hint-left 1.6s ease-in-out infinite;
  }

  .comparison__hint .comparison__hint-arrow--right {
    animation: comparison-hint-right 1.6s ease-in-out infinite;
  }

  @keyframes comparison-hint-left {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(-5px); }
  }

  @keyframes comparison-hint-right {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(5px); }
  }

  .comparison__layout {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    max-width: 1320px;
    margin: 0 auto;
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    .comparison__layout {
      flex-direction: row;
      align-items: center;
      gap: 5rem;
    }
  }

  .comparison__image-wrap {
    position: relative;
    perspective: 1400px;
    width: 100%;
    max-width: 640px;
    flex: 0 0 auto;
  }

  .comparison__image-wrap::before {
    content: "";
    position: absolute;
    inset: -10%;
    background: radial-gradient(circle at 50% 45%, rgba(217, 33, 51, 0.14), rgba(217, 33, 51, 0) 65%);
    z-index: 0;
    pointer-events: none;
  }

  @media screen and (min-width: 990px) {
    .comparison__image-wrap {
      flex: 0 0 62%;
      max-width: none;
      width: 62%;
    }
  }

  .comparison__image-frame {
    position: relative;
    z-index: 1;
    overflow: hidden;
  }

  .comparison__image-inner {
    position: relative;
    transform: scale(1.32);
    transform-origin: center 42%;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .comparison__image {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 45px 50px rgba(0, 0, 0, 0.35));
  }

  .comparison__marker {
    position: absolute;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 50%;
    background: #d92133;
    color: #ffffff;
    border: 3px solid #ffffff;
    font-weight: 800;
    font-size: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translate(-50%, -50%);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.35);
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .comparison__marker::after {
    content: "";
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 2px solid rgba(217, 33, 51, 0.5);
    animation: comparison-marker-pulse 2.2s ease-out infinite;
  }

  @keyframes comparison-marker-pulse {
    0% { transform: scale(0.85); opacity: 1; }
    100% { transform: scale(1.6); opacity: 0; }
  }

  .comparison__marker.is-active {
    background: #191919;
    transform: translate(-50%, -50%) scale(1.15);
  }

  .comparison__legend {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: 100%;
  }

  @media screen and (min-width: 990px) {
    .comparison__legend {
      flex: 1 1 auto;
    }
  }

  .comparison__legend-item {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.5rem;
    border-radius: 16px;
    background: rgb(var(--color-background));
    border: 1px solid rgba(var(--color-foreground), 0.07);
    box-shadow: 0 10px 30px -18px rgba(0, 0, 0, 0.25);
    transition: background-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    cursor: pointer;
  }

  .comparison__legend-item:hover {
    transform: translateX(4px);
  }

  .comparison__legend-item.is-active {
    background: rgba(217, 33, 51, 0.05);
    border-color: rgba(217, 33, 51, 0.25);
    box-shadow: 0 14px 34px -16px rgba(217, 33, 51, 0.35);
  }

  .comparison__legend-number {
    flex: 0 0 auto;
    width: 3.1rem;
    height: 3.1rem;
    border-radius: 50%;
    background: #d92133;
    color: #ffffff;
    font-weight: 800;
    font-size: 1.3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 14px -2px rgba(217, 33, 51, 0.45);
  }

  .comparison__legend-item.is-active .comparison__legend-number {
    background: #191919;
  }

  .comparison__legend-heading {
    font-weight: 800;
    font-size: 1.65rem;
    margin: 0 0 0.35rem;
  }

  .comparison__legend-text {
    font-size: 1.25rem;
    line-height: 1.5;
    color: rgba(var(--color-foreground), 0.68);
    margin: 0;
  }

  .comparison__features {
    margin-top: 5.5rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.75rem 2rem;
    max-width: 1260px;
    margin-left: auto;
    margin-right: auto;
  }

  @media screen and (min-width: 750px) {
    .comparison__features {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .comparison__feature {
    text-align: center;
  }

  .comparison__feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 6.5rem;
    height: 6.5rem;
    margin-bottom: 1.35rem;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, rgba(217, 33, 51, 0.14), rgba(217, 33, 51, 0.05));
    border: 1px solid rgba(217, 33, 51, 0.15);
    transition: transform 0.3s ease;
  }

  .comparison__feature:hover .comparison__feature-icon {
    transform: scale(1.08) rotate(-4deg);
  }

  .comparison__feature-icon .svg-wrapper {
    width: 45%;
    height: 45%;
    fill: #d92133;
  }

  .comparison__feature-heading {
    margin: 0 0 0.55rem;
    font-size: 1.8rem;
    font-weight: 800;
  }

  .comparison__feature-text {
    font-size: 1.35rem;
    color: rgba(var(--color-foreground), 0.68);
    line-height: 1.55;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding comparison comparison-{{ section.id }}">
    <div class="comparison__top">
      <h2 class="comparison__heading title {{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>
      {%- if section.settings.subheading != blank -%}
        <p class="comparison__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <p class="comparison__hint">
      <svg class="comparison__hint-arrow--left" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
      Tap a number to see the detail
      <svg class="comparison__hint-arrow--right" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
    </p>

    <div class="comparison__layout">
      <div class="comparison__image-wrap" data-comparison-tilt>
        <div class="comparison__image-frame">
          <div class="comparison__image-inner">
            {%- if section.settings.showcase_image != blank -%}
              <img
                class="comparison__image"
                src="{{ section.settings.showcase_image | image_url: width: 1200 }}"
                alt="{{ section.settings.showcase_image.alt | default: 'Featured jacket' | escape }}"
                width="{{ section.settings.showcase_image.width }}"
                height="{{ section.settings.showcase_image.height }}"
                loading="lazy"
              >
            {%- endif -%}

            {%- for block in section.blocks -%}
              {%- if block.type == 'detail' -%}
                <button
                  type="button"
                  class="comparison__marker"
                  style="top: {{ block.settings.position_top }}%; left: {{ block.settings.position_left }}%;"
                  data-marker-index="{{ forloop.index }}"
                  aria-label="{{ block.settings.heading | escape }}"
                  {{ block.shopify_attributes }}
                >{{ forloop.index }}</button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>

      <div class="comparison__legend">
        {%- for block in section.blocks -%}
          {%- if block.type == 'detail' -%}
            <div class="comparison__legend-item" data-legend-index="{{ forloop.index }}">
              <span class="comparison__legend-number">{{ forloop.index }}</span>
              <div>
                <p class="comparison__legend-heading">{{ block.settings.heading | escape }}</p>
                <p class="comparison__legend-text">{{ block.settings.text | escape }}</p>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="comparison__features">
      {%- for block in section.blocks -%}
        {%- if block.type == 'feature' -%}
          <div class="comparison__feature" {{ block.shopify_attributes }}>
            <span class="comparison__feature-icon">
              {%- render 'icon-accordion', icon: block.settings.icon -%}
            </span>
            <h3 class="comparison__feature-heading h5">{{ block.settings.heading | escape }}</h3>
            <p class="comparison__feature-text">{{ block.settings.text | escape }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var section = document.currentScript.closest('.comparison-{{ section.id }}') || document.querySelector('.comparison-{{ section.id }}');
    if (!section) return;

    var markers = section.querySelectorAll('.comparison__marker');
    var legendItems = section.querySelectorAll('.comparison__legend-item');

    function clearActive() {
      markers.forEach(function (m) { m.classList.remove('is-active'); });
      legendItems.forEach(function (l) { l.classList.remove('is-active'); });
    }

    function setActive(index) {
      var alreadyActive = section.querySelector('.comparison__marker.is-active[data-marker-index="' + index + '"]');
      clearActive();
      if (alreadyActive) return;
      var marker = section.querySelector('.comparison__marker[data-marker-index="' + index + '"]');
      var legendItem = section.querySelector('.comparison__legend-item[data-legend-index="' + index + '"]');
      if (marker) marker.classList.add('is-active');
      if (legendItem) legendItem.classList.add('is-active');
    }

    markers.forEach(function (marker) {
      marker.addEventListener('click', function () {
        setActive(marker.getAttribute('data-marker-index'));
      });
    });

    legendItems.forEach(function (item) {
      item.addEventListener('mouseenter', function () {
        setActive(item.getAttribute('data-legend-index'));
      });
      item.addEventListener('click', function () {
        setActive(item.getAttribute('data-legend-index'));
      });
    });

    var isCoarsePointer = window.matchMedia('(pointer: coarse)').matches;
    if (isCoarsePointer) return;

    var outer = section.querySelector('[data-comparison-tilt]');
    var inner = section.querySelector('.comparison__image-inner');
    if (!outer || !inner) return;

    var maxTilt = 9;
    var baseScale = 'scale(1.32) ';

    outer.addEventListener('mousemove', function (event) {
      var rect = outer.getBoundingClientRect();
      var x = (event.clientX - rect.left) / rect.width;
      var y = (event.clientY - rect.top) / rect.height;
      var rotateY = (x - 0.5) * maxTilt * 2;
      var rotateX = (0.5 - y) * maxTilt;
      inner.style.transform = baseScale + 'rotateX(' + rotateX + 'deg) rotateY(' + rotateY + 'deg)';
    });

    outer.addEventListener('mouseleave', function () {
      inner.style.transform = baseScale + 'rotateX(0deg) rotateY(0deg)';
    });
  })();
</script>

{% schema %}
{
  "name": "Comparison table",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
