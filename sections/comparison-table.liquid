{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .comparison-{{ section.id }} .comparison__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
    margin-bottom: 3rem;
  }

  @media screen and (min-width: 750px) {
    .comparison-{{ section.id }} .comparison__top {
      grid-template-columns: 1fr 1.3fr;
      gap: 3rem;
    }
  }

  .comparison__heading {
    font-weight: 800;
    letter-spacing: 0.02em;
    margin: 0;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .comparison__heading {
      text-align: left;
    }
  }

  .comparison__table {
    position: relative;
    border: 1px solid rgba(var(--color-foreground), 0.12);
    border-radius: 14px;
    overflow: hidden;
    background: rgb(var(--color-background));
  }

  .comparison__table-head,
  .comparison__row {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    align-items: center;
  }

  .comparison__table-head {
    padding: 0.9rem 1.25rem;
  }

  .comparison__table-head span {
    text-align: center;
    font-weight: 700;
    font-size: 0.95rem;
  }

  .comparison__table-head span:first-child {
    visibility: hidden;
  }

  .comparison__row {
    padding: 1rem 1.25rem;
    border-top: 1px solid rgba(var(--color-foreground), 0.1);
  }

  .comparison__row-label {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .comparison__cell {
    display: flex;
    justify-content: center;
  }

  .comparison__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.6rem;
    height: 1.6rem;
  }

  .comparison__mark--yes {
    color: #ffffff;
  }

  .comparison__mark--yes svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .comparison__mark--no {
    color: rgba(var(--color-foreground), 0.35);
    font-size: 1.15rem;
    font-weight: 700;
  }

  .comparison__brand-col {
    position: relative;
  }

  .comparison__brand-highlight {
    position: absolute;
    top: -14px;
    bottom: -1px;
    left: 50%;
    width: calc(33.33% - 0.5rem);
    transform: translateX(calc(-50% + 23.5%));
    background: #d92133;
    border-radius: 12px;
    box-shadow: 0 10px 24px rgba(217, 33, 51, 0.25);
    z-index: 0;
  }

  @media screen and (min-width: 750px) {
    .comparison__brand-highlight {
      transform: translateX(calc(-50% + 23%));
    }
  }

  .comparison__table-head,
  .comparison__row {
    position: relative;
    z-index: 1;
  }

  .comparison__table-head span:nth-child(2),
  .comparison__row .comparison__cell:nth-child(2) {
    color: #ffffff;
  }

  .comparison__mark--no.comparison__mark--brand {
    color: rgba(255, 255, 255, 0.6);
  }

  .comparison__features {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem 1.5rem;
  }

  @media screen and (min-width: 750px) {
    .comparison__features {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .comparison__feature {
    text-align: center;
  }

  .comparison__feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 0.9rem;
  }

  .comparison__feature-icon .svg-wrapper {
    width: 100%;
    height: 100%;
    fill: rgb(var(--color-foreground));
  }

  .comparison__feature-heading {
    margin: 0 0 0.4rem;
  }

  .comparison__feature-text {
    font-size: 0.85rem;
    color: rgba(var(--color-foreground), 0.75);
    line-height: 1.4;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding comparison comparison-{{ section.id }}">
    <div class="comparison__top">
      <h2 class="comparison__heading title {{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>

      <div class="comparison__table">
        <div class="comparison__brand-highlight" aria-hidden="true"></div>
        <div class="comparison__table-head">
          <span></span>
          <span>{{ section.settings.brand_label | escape }}</span>
          <span>{{ section.settings.others_label | escape }}</span>
        </div>
        {%- for block in section.blocks -%}
          {%- if block.type == 'row' -%}
            <div class="comparison__row" {{ block.shopify_attributes }}>
              <p class="comparison__row-label">{{ block.settings.label | escape }}</p>
              <div class="comparison__cell">
                <span class="comparison__mark comparison__mark--yes">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="4 12.5 9.5 18 20 6"></polyline></svg>
                </span>
              </div>
              <div class="comparison__cell">
                <span class="comparison__mark comparison__mark--no" aria-hidden="true">&#10005;</span>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="comparison__features">
      {%- for block in section.blocks -%}
        {%- if block.type == 'feature' -%}
          <div class="comparison__feature" {{ block.shopify_attributes }}>
            <span class="comparison__feature-icon">
              {%- render 'icon-accordion', icon: block.settings.icon -%}
            </span>
            <h3 class="comparison__feature-heading h5">{{ block.settings.heading | escape }}</h3>
            <p class="comparison__feature-text">{{ block.settings.text | escape }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Comparison table",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Title",
      "default": "Overtake vs the rest"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Title size",
      "options": [
        { "value": "h2", "label": "Normal" },
        { "value": "h1", "label": "Large" },
        { "value": "h0", "label": "Extra large" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "brand_label",
      "label": "Brand column label",
      "default": "Overtake"
    },
    {
      "type": "text",
      "id": "others_label",
      "label": "Other sellers column label",
      "default": "Others"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 44
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Row label",
          "default": "Heavyweight fabric"
        }
      ]
    },
    {
      "type": "feature",
      "name": "Feature icon",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "check_mark", "label": "Checkmark" },
            { "value": "lightning_bolt", "label": "Lightning bolt" },
            { "value": "star", "label": "Star" },
            { "value": "heart", "label": "Heart" },
            { "value": "leather", "label": "Leather" },
            { "value": "shirt", "label": "Shirt" },
            { "value": "truck", "label": "Truck" },
            { "value": "return", "label": "Return" },
            { "value": "lock", "label": "Lock" },
            { "value": "price_tag", "label": "Price tag" }
          ],
          "default": "check_mark"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Title",
          "default": "Quality guarantee"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "[PLACEHOLDER — supporting text]"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison table",
      "blocks": [
        { "type": "row", "settings": { "label": "Heavyweight embroidered fabric" } },
        { "type": "row", "settings": { "label": "Officially inspired vintage designs" } },
        { "type": "row", "settings": { "label": "Tracked worldwide shipping" } },
        { "type": "row", "settings": { "label": "Easy returns & exchanges" } },
        {
          "type": "feature",
          "settings": {
            "icon": "check_mark",
            "heading": "Quality guarantee",
            "text": "If your jacket arrives damaged, we replace it at no cost."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "lightning_bolt",
            "heading": "Premium stitching",
            "text": "Heavyweight fabric with reinforced embroidery on every patch."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "star",
            "heading": "Unique designs",
            "text": "Vintage racing looks you won't find on fast-fashion sites."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "heart",
            "heading": "Instant style upgrade",
            "text": "Turn heads with a jacket that stands out from the grid."
          }
        }
      ]
    }
  ]
}
{% endschema %}
