{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .comparison-{{ section.id }} .comparison__top {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 1.5rem;
  }

  .comparison__heading {
    font-weight: 800;
    letter-spacing: -0.01em;
    margin: 0 0 1.25rem;
    font-size: clamp(2.6rem, 2rem + 2.2vw, 4rem) !important;
  }

  .comparison__subheading {
    font-size: clamp(1.3rem, 1.1rem + 0.7vw, 1.7rem);
    color: rgba(var(--color-foreground), 0.65);
    margin: 0;
  }

  .comparison__hint {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin: 0 auto 2.5rem;
    max-width: 1120px;
    font-size: clamp(0.85rem, 0.75rem + 0.4vw, 1.05rem);
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: rgba(var(--color-foreground), 0.45);
  }

  .comparison__hint svg {
    width: 1.4rem;
    height: 1.4rem;
    stroke: currentColor;
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .comparison__hint .comparison__hint-arrow--left {
    animation: comparison-hint-left 1.6s ease-in-out infinite;
  }

  .comparison__hint .comparison__hint-arrow--right {
    animation: comparison-hint-right 1.6s ease-in-out infinite;
  }

  @keyframes comparison-hint-left {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(-5px); }
  }

  @keyframes comparison-hint-right {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(5px); }
  }

  .comparison__layout {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    max-width: 1320px;
    margin: 0 auto;
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    .comparison__layout {
      flex-direction: row;
      align-items: center;
      gap: 5rem;
    }
  }

  .comparison__image-wrap {
    position: relative;
    perspective: 1400px;
    width: 100%;
    max-width: 460px;
    flex: 0 0 auto;
  }

  .comparison__image-wrap::before {
    content: "";
    position: absolute;
    inset: -10%;
    background: radial-gradient(circle at 50% 45%, rgba(217, 33, 51, 0.14), rgba(217, 33, 51, 0) 65%);
    z-index: 0;
    pointer-events: none;
  }

  @media screen and (min-width: 990px) {
    .comparison__image-wrap {
      flex: 0 0 44%;
      max-width: none;
      width: 44%;
    }
  }

  .comparison__image-inner {
    position: relative;
    z-index: 1;
    transform: scale(1.28);
    transform-origin: center 42%;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), filter 0.3s ease;
    will-change: transform;
  }

  .comparison__image-wrap.is-zoomed .comparison__image-inner {
    filter: blur(6px) brightness(0.85);
  }

  .comparison__magnifier {
    position: fixed;
    inset: 0;
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .comparison__magnifier.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  .comparison__magnifier-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(10, 10, 10, 0.6);
  }

  .comparison__magnifier-card {
    position: relative;
    z-index: 1;
    width: min(320px, 78vw);
    height: min(320px, 78vw);
    transform: scale(0.82);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .comparison__magnifier.is-visible .comparison__magnifier-card {
    transform: scale(1);
  }

  .comparison__magnifier-glass {
    width: 100%;
    height: 100%;
    border-radius: 20px;
    background-color: #ffffff;
    background-repeat: no-repeat;
    border: 4px solid #ffffff;
    box-shadow: 0 22px 45px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(0, 0, 0, 0.06);
  }

  .comparison__magnifier-close {
    position: absolute;
    top: -12px;
    right: -12px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #191919;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #ffffff;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.35);
    cursor: pointer;
    padding: 0;
  }

  .comparison__magnifier-close svg {
    width: 14px;
    height: 14px;
    stroke: currentColor;
    fill: none;
    stroke-width: 2.5;
    stroke-linecap: round;
  }

  .comparison__image {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 45px 50px rgba(0, 0, 0, 0.35));
  }

  .comparison__marker {
    position: absolute;
    width: clamp(2.2rem, 1.8rem + 1.4vw, 2.9rem);
    height: clamp(2.2rem, 1.8rem + 1.4vw, 2.9rem);
    border-radius: 50%;
    background: #d92133;
    color: #ffffff;
    border: 3px solid #ffffff;
    font-weight: 800;
    font-size: clamp(1rem, 0.85rem + 0.6vw, 1.25rem);
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translate(-50%, -50%);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.35);
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .comparison__marker::after {
    content: "";
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 2px solid rgba(217, 33, 51, 0.5);
    animation: comparison-marker-pulse 2.2s ease-out infinite;
  }

  @keyframes comparison-marker-pulse {
    0% { transform: scale(0.85); opacity: 1; }
    100% { transform: scale(1.6); opacity: 0; }
  }

  .comparison__marker.is-active {
    background: #191919;
    transform: translate(-50%, -50%) scale(1.15);
  }

  .comparison__legend {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: 100%;
  }

  @media screen and (min-width: 990px) {
    .comparison__legend {
      flex: 1 1 auto;
    }
  }

  .comparison__legend-item {
    position: relative;
    display: flex;
    gap: 1.35rem;
    align-items: flex-start;
    padding: 1.75rem 1.75rem 1.75rem 2.1rem;
    border-radius: 18px;
    background: linear-gradient(180deg, rgb(var(--color-background)) 0%, rgba(0, 0, 0, 0.015) 100%);
    border: 1px solid rgba(var(--color-foreground), 0.08);
    box-shadow: 0 14px 30px -22px rgba(0, 0, 0, 0.3);
    transition: background 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease, border-color 0.25s ease;
    cursor: pointer;
    overflow: hidden;
  }

  .comparison__legend-item::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 4px;
    background: rgba(217, 33, 51, 0.18);
    transition: width 0.25s ease, background 0.25s ease;
  }

  .comparison__legend-item:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 36px -20px rgba(0, 0, 0, 0.3);
  }

  .comparison__legend-item.is-active {
    background: linear-gradient(180deg, rgba(217, 33, 51, 0.07), rgba(217, 33, 51, 0.02));
    border-color: rgba(217, 33, 51, 0.3);
    box-shadow: 0 20px 40px -18px rgba(217, 33, 51, 0.32);
    transform: translateY(-2px);
  }

  .comparison__legend-item.is-active::before {
    width: 6px;
    background: #d92133;
  }

  .comparison__legend-number {
    flex: 0 0 auto;
    width: clamp(2.4rem, 2rem + 1.4vw, 3.1rem);
    height: clamp(2.4rem, 2rem + 1.4vw, 3.1rem);
    border-radius: 50%;
    background: linear-gradient(135deg, #e63c4f, #b3101f);
    color: #ffffff;
    font-weight: 800;
    font-size: clamp(1.05rem, 0.9rem + 0.6vw, 1.3rem);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 18px -4px rgba(217, 33, 51, 0.5);
    transition: background 0.25s ease, transform 0.25s ease;
  }

  .comparison__legend-item:hover .comparison__legend-number {
    transform: scale(1.06);
  }

  .comparison__legend-item.is-active .comparison__legend-number {
    background: linear-gradient(135deg, #2b2b2b, #101010);
  }

  .comparison__legend-heading {
    font-weight: 800;
    font-size: clamp(1.3rem, 1.1rem + 0.6vw, 1.65rem);
    margin: 0 0 0.35rem;
  }

  .comparison__legend-text {
    font-size: clamp(1.05rem, 0.95rem + 0.4vw, 1.25rem);
    line-height: 1.5;
    color: rgba(var(--color-foreground), 0.68);
    margin: 0;
  }

{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding comparison comparison-{{ section.id }}">
    <div class="comparison__top">
      <h2 class="comparison__heading title {{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>
      {%- if section.settings.subheading != blank -%}
        <p class="comparison__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <p class="comparison__hint">
      <svg class="comparison__hint-arrow--left" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
      Tap a number to see the detail
      <svg class="comparison__hint-arrow--right" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
    </p>

    <div class="comparison__layout">
      <div class="comparison__image-wrap" data-comparison-tilt>
        <div class="comparison__image-inner">
          {%- if section.settings.showcase_image != blank -%}
            <img
              class="comparison__image"
              src="{{ section.settings.showcase_image | image_url: width: 1200 }}"
              alt="{{ section.settings.showcase_image.alt | default: 'Featured jacket' | escape }}"
              width="{{ section.settings.showcase_image.width }}"
              height="{{ section.settings.showcase_image.height }}"
              loading="lazy"
            >
          {%- endif -%}

          {%- for block in section.blocks -%}
            {%- if block.type == 'detail' -%}
              <button
                type="button"
                class="comparison__marker"
                style="top: {{ block.settings.position_top }}%; left: {{ block.settings.position_left }}%;"
                data-marker-index="{{ forloop.index }}"
                data-top="{{ block.settings.position_top }}"
                data-left="{{ block.settings.position_left }}"
                aria-label="{{ block.settings.heading | escape }}"
                {{ block.shopify_attributes }}
              >{{ forloop.index }}</button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <div class="comparison__legend">
        {%- for block in section.blocks -%}
          {%- if block.type == 'detail' -%}
            <div class="comparison__legend-item" data-legend-index="{{ forloop.index }}">
              <span class="comparison__legend-number">{{ forloop.index }}</span>
              <div>
                <p class="comparison__legend-heading">{{ block.settings.heading | escape }}</p>
                <p class="comparison__legend-text">{{ block.settings.text | escape }}</p>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="comparison__magnifier" data-magnifier aria-hidden="true">
      <div class="comparison__magnifier-backdrop" data-magnifier-backdrop></div>
      <div class="comparison__magnifier-card">
        <div class="comparison__magnifier-glass" data-magnifier-glass></div>
        <button type="button" class="comparison__magnifier-close" data-magnifier-close aria-label="{{ 'accessibility.close' | t }}">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var section = document.currentScript.closest('.comparison-{{ section.id }}') || document.querySelector('.comparison-{{ section.id }}');
    if (!section) return;

    var markers = section.querySelectorAll('.comparison__marker');
    var legendItems = section.querySelectorAll('.comparison__legend-item');
    var inner = section.querySelector('.comparison__image-inner');
    var outer = section.querySelector('[data-comparison-tilt]');
    var image = section.querySelector('.comparison__image');
    var magnifier = section.querySelector('[data-magnifier]');
    var magnifierGlass = section.querySelector('[data-magnifier-glass]');
    var magnifierClose = section.querySelector('[data-magnifier-close]');
    var magnifierBackdrop = section.querySelector('[data-magnifier-backdrop]');

    var zoomFactor = 2.6;
    var lastRotate = { x: 0, y: 0 };

    function applyTransform() {
      if (!inner) return;
      inner.style.transform = 'scale(1.28) rotateX(' + lastRotate.x + 'deg) rotateY(' + lastRotate.y + 'deg)';
    }

    function showMagnifier(marker) {
      if (!magnifier || !magnifierGlass || !image) return;
      var renderedWidth = image.offsetWidth;
      var renderedHeight = image.offsetHeight;
      if (!renderedWidth || !renderedHeight) return;

      var leftPercent = parseFloat(marker.getAttribute('data-left')) || 0;
      var topPercent = parseFloat(marker.getAttribute('data-top')) || 0;
      var targetX = (leftPercent / 100) * renderedWidth;
      var targetY = (topPercent / 100) * renderedHeight;

      var glassWidth = magnifierGlass.offsetWidth;
      var glassHeight = magnifierGlass.offsetHeight;

      magnifierGlass.style.backgroundImage = 'url(' + image.src + ')';
      magnifierGlass.style.backgroundSize = (renderedWidth * zoomFactor) + 'px ' + (renderedHeight * zoomFactor) + 'px';
      magnifierGlass.style.backgroundPosition =
        (-(targetX * zoomFactor - glassWidth / 2)) + 'px ' +
        (-(targetY * zoomFactor - glassHeight / 2)) + 'px';

      magnifier.classList.add('is-visible');
      if (outer) outer.classList.add('is-zoomed');
    }

    function hideMagnifier() {
      if (magnifier) magnifier.classList.remove('is-visible');
      if (outer) outer.classList.remove('is-zoomed');
    }

    function clearActive() {
      markers.forEach(function (m) { m.classList.remove('is-active'); });
      legendItems.forEach(function (l) { l.classList.remove('is-active'); });
      hideMagnifier();
    }

    function setActive(index) {
      var alreadyActive = section.querySelector('.comparison__marker.is-active[data-marker-index="' + index + '"]');
      clearActive();
      if (alreadyActive) return;
      var marker = section.querySelector('.comparison__marker[data-marker-index="' + index + '"]');
      var legendItem = section.querySelector('.comparison__legend-item[data-legend-index="' + index + '"]');
      if (marker) {
        marker.classList.add('is-active');
        showMagnifier(marker);
      }
      if (legendItem) legendItem.classList.add('is-active');
    }

    markers.forEach(function (marker) {
      marker.addEventListener('click', function () {
        setActive(marker.getAttribute('data-marker-index'));
      });
    });

    legendItems.forEach(function (item) {
      item.addEventListener('mouseenter', function () {
        setActive(item.getAttribute('data-legend-index'));
      });
      item.addEventListener('click', function () {
        setActive(item.getAttribute('data-legend-index'));
      });
    });

    if (magnifierClose) {
      magnifierClose.addEventListener('click', function (event) {
        event.stopPropagation();
        clearActive();
      });
    }

    if (magnifierBackdrop) {
      magnifierBackdrop.addEventListener('click', function () {
        clearActive();
      });
    }

    if (!outer || !inner) return;

    var maxTilt = 12;

    outer.addEventListener('mousemove', function (event) {
      var rect = outer.getBoundingClientRect();
      var x = (event.clientX - rect.left) / rect.width;
      var y = (event.clientY - rect.top) / rect.height;
      lastRotate.y = (x - 0.5) * maxTilt * 2;
      lastRotate.x = (0.5 - y) * maxTilt;
      applyTransform();
    });

    outer.addEventListener('mouseleave', function () {
      lastRotate.x = 0;
      lastRotate.y = 0;
      applyTransform();
    });
  })();
</script>

{% schema %}
{
  "name": "Comparison table",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Title",
      "default": "Overtake vs the rest"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Title size",
      "options": [
        { "value": "h2", "label": "Normal" },
        { "value": "h1", "label": "Large" },
        { "value": "h0", "label": "Extra large" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "See why thousands of racing fans choose us over generic sellers"
    },
    {
      "type": "image_picker",
      "id": "showcase_image",
      "label": "Featured product image",
      "info": "Use a cutout image (transparent background) for the best look."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 44
    }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Detail marker",
      "settings": [
        {
          "type": "range",
          "id": "position_top",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Vertical position on image",
          "default": 20
        },
        {
          "type": "range",
          "id": "position_left",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Horizontal position on image",
          "default": 50
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Detail title",
          "default": "Detail title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Detail description",
          "default": "[PLACEHOLDER — describe this detail]"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison table",
      "blocks": [
        {
          "type": "detail",
          "settings": {
            "position_top": 17,
            "position_left": 52,
            "heading": "Full-zip heavyweight build",
            "text": "A sturdy front zip and heavyweight fabric that holds its shape wear after wear."
          }
        },
        {
          "type": "detail",
          "settings": {
            "position_top": 35,
            "position_left": 58,
            "heading": "Embroidered team crest",
            "text": "Officially inspired crest patch, stitched (not printed) for a durable finish."
          }
        },
        {
          "type": "detail",
          "settings": {
            "position_top": 58,
            "position_left": 18,
            "heading": "Bold sleeve branding",
            "text": "Vintage-style lettering down the sleeve, a detail fast-fashion copies skip."
          }
        },
        {
          "type": "detail",
          "settings": {
            "position_top": 77,
            "position_left": 50,
            "heading": "Ribbed cuffs & hem",
            "text": "Reinforced ribbing keeps the fit snug and the jacket looking sharp longer."
          }
        }
      ]
    }
  ]
}
