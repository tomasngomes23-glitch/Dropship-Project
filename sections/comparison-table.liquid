{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .comparison-{{ section.id }} .comparison__top {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 1.5rem;
  }

  .comparison__heading {
    font-weight: 800;
    letter-spacing: -0.01em;
    margin: 0 0 1.25rem;
    font-size: clamp(2.6rem, 2rem + 2.2vw, 4rem) !important;
  }

  .comparison__subheading {
    font-size: clamp(1.3rem, 1.1rem + 0.7vw, 1.7rem);
    color: rgba(var(--color-foreground), 0.65);
    margin: 0;
  }

  .comparison__hint {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin: 0 auto 2.5rem;
    max-width: 1120px;
    font-size: clamp(0.85rem, 0.75rem + 0.4vw, 1.05rem);
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: rgba(var(--color-foreground), 0.45);
  }

  .comparison__hint svg {
    width: 1.4rem;
    height: 1.4rem;
    stroke: currentColor;
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .comparison__hint .comparison__hint-arrow--left {
    animation: comparison-hint-left 1.6s ease-in-out infinite;
  }

  .comparison__hint .comparison__hint-arrow--right {
    animation: comparison-hint-right 1.6s ease-in-out infinite;
  }

  @keyframes comparison-hint-left {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(-5px); }
  }

  @keyframes comparison-hint-right {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(5px); }
  }

  .comparison__layout {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    max-width: 1320px;
    margin: 0 auto;
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    .comparison__layout {
      flex-direction: row;
      align-items: center;
      gap: 5rem;
    }
  }

  .comparison__image-wrap {
    position: relative;
    perspective: 1400px;
    width: 100%;
    max-width: 640px;
    flex: 0 0 auto;
  }

  .comparison__image-wrap::before {
    content: "";
    position: absolute;
    inset: -10%;
    background: radial-gradient(circle at 50% 45%, rgba(217, 33, 51, 0.14), rgba(217, 33, 51, 0) 65%);
    z-index: 0;
    pointer-events: none;
  }

  @media screen and (min-width: 990px) {
    .comparison__image-wrap {
      flex: 0 0 58%;
      max-width: none;
      width: 58%;
    }
  }

  .comparison__image-inner {
    position: relative;
    z-index: 1;
    transform: scale(1.3);
    transform-origin: center 42%;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .comparison__image {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 45px 50px rgba(0, 0, 0, 0.35));
  }

  .comparison__marker {
    position: absolute;
    width: clamp(2.1rem, 1.6rem + 1.4vw, 2.8rem);
    height: clamp(2.1rem, 1.6rem + 1.4vw, 2.8rem);
    border-radius: 50%;
    background: #d92133;
    color: #ffffff;
    border: 3px solid #ffffff;
    font-weight: 800;
    font-size: clamp(0.9rem, 0.75rem + 0.5vw, 1.15rem);
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translate(-50%, -50%);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.35);
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .comparison__marker::after {
    content: "";
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 2px solid rgba(217, 33, 51, 0.5);
    animation: comparison-marker-pulse 2.2s ease-out infinite;
  }

  @keyframes comparison-marker-pulse {
    0% { transform: scale(0.85); opacity: 1; }
    100% { transform: scale(1.6); opacity: 0; }
  }

  .comparison__marker.is-active {
    background: #191919;
    transform: translate(-50%, -50%) scale(1.15);
  }

  .comparison__legend {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    width: 100%;
  }

  @media screen and (min-width: 700px) {
    .comparison__legend {
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }
  }

  @media screen and (min-width: 990px) {
    .comparison__legend {
      flex: 1 1 auto;
      grid-template-columns: 1fr 1fr;
    }
  }

  .comparison__legend-item {
    position: relative;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.5rem;
    border: 1px solid rgba(var(--color-foreground), 0.12);
    border-radius: 16px;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    cursor: pointer;
  }

  .comparison__legend-item:hover {
    background: rgba(217, 33, 51, 0.04);
    border-color: rgba(217, 33, 51, 0.3);
    transform: translateY(-2px);
    box-shadow: 0 10px 24px -16px rgba(0, 0, 0, 0.35);
  }

  .comparison__legend-item.is-active {
    background: rgba(217, 33, 51, 0.08);
    border-color: #d92133;
  }

  .comparison__legend-number {
    flex: 0 0 auto;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: #191919;
    color: #ffffff;
    font-weight: 800;
    font-size: 1.05rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
  }

  .comparison__legend-item.is-active .comparison__legend-number {
    background: #d92133;
  }

  .comparison__legend-heading {
    font-weight: 800;
    font-size: 1.15rem;
    margin: 0 0 0.2rem;
  }

  .comparison__legend-text {
    font-size: 0.95rem;
    line-height: 1.45;
    color: rgba(var(--color-foreground), 0.65);
    margin: 0;
  }

  .comparison__zoom-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .comparison__zoom-modal.is-open {
    opacity: 1;
    visibility: visible;
  }

  .comparison__zoom-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(10, 10, 10, 0.72);
  }

  .comparison__zoom-modal-content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 640px;
    background: var(--color-background, #ffffff);
    border-radius: 20px;
    overflow: hidden;
    transform: scale(0.94);
    transition: transform 0.25s ease;
  }

  .comparison__zoom-modal.is-open .comparison__zoom-modal-content {
    transform: scale(1);
  }

  .comparison__zoom-modal-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 2;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: none;
    background: rgba(0, 0, 0, 0.55);
    color: #ffffff;
    font-size: 1.5rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .comparison__zoom-viewport {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #f2f2f2;
  }

  .comparison__zoom-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: scale(1);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), transform-origin 0.5s ease;
  }

  .comparison__zoom-marker {
    position: absolute;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: #d92133;
    color: #ffffff;
    border: 3px solid #ffffff;
    font-weight: 800;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translate(-50%, -50%);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.4);
    pointer-events: none;
  }

  .comparison__zoom-caption {
    padding: 1.5rem 1.75rem 1.75rem;
  }

  .comparison__zoom-heading {
    font-weight: 800;
    font-size: 1.3rem;
    margin: 0 0 0.4rem;
  }

  .comparison__zoom-text {
    font-size: 1rem;
    line-height: 1.5;
    color: rgba(var(--color-foreground), 0.7);
    margin: 0;
  }

{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding comparison comparison-{{ section.id }}">
    <div class="comparison__top">
      <h2 class="comparison__heading title {{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>
      {%- if section.settings.subheading != blank -%}
        <p class="comparison__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <p class="comparison__hint">
      <svg class="comparison__hint-arrow--left" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
      Tap a number to see the detail
      <svg class="comparison__hint-arrow--right" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
    </p>

    <div class="comparison__layout">
      <div class="comparison__image-wrap">
        <div class="comparison__image-inner">
          {%- if section.settings.showcase_image != blank -%}
            <img
              class="comparison__image"
              src="{{ section.settings.showcase_image | image_url: width: 1200 }}"
              alt="{{ section.settings.showcase_image.alt | default: 'Featured jacket' | escape }}"
              width="{{ section.settings.showcase_image.width }}"
              height="{{ section.settings.showcase_image.height }}"
              loading="lazy"
            >
          {%- endif -%}

          {%- for block in section.blocks -%}
            {%- if block.type == 'detail' -%}
              <button
                type="button"
                class="comparison__marker"
                style="top: {{ block.settings.position_top }}%; left: {{ block.settings.position_left }}%;"
                data-marker-index="{{ forloop.index }}"
                data-position-top="{{ block.settings.position_top }}"
                data-position-left="{{ block.settings.position_left }}"
                data-heading="{{ block.settings.heading | escape }}"
                data-text="{{ block.settings.text | escape }}"
                aria-label="{{ block.settings.heading | escape }}"
                {{ block.shopify_attributes }}
              >{{ forloop.index }}</button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <div class="comparison__legend">
        {%- for block in section.blocks -%}
          {%- if block.type == 'detail' -%}
            <div
              class="comparison__legend-item"
              data-legend-index="{{ forloop.index }}"
              data-position-top="{{ block.settings.position_top }}"
              data-position-left="{{ block.settings.position_left }}"
              data-heading="{{ block.settings.heading | escape }}"
              data-text="{{ block.settings.text | escape }}"
            >
              <span class="comparison__legend-number">{{ forloop.index }}</span>
              <div>
                <p class="comparison__legend-heading">{{ block.settings.heading | escape }}</p>
                <p class="comparison__legend-text">{{ block.settings.text | escape }}</p>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <div class="comparison__zoom-modal" aria-hidden="true">
    <div class="comparison__zoom-modal-backdrop"></div>
    <div class="comparison__zoom-modal-content">
      <button type="button" class="comparison__zoom-modal-close" aria-label="Close">&times;</button>
      <div class="comparison__zoom-viewport">
        {%- if section.settings.showcase_image != blank -%}
          <img
            class="comparison__zoom-image"
            src="{{ section.settings.showcase_image | image_url: width: 2000 }}"
            alt="{{ section.settings.showcase_image.alt | default: 'Featured jacket' | escape }}"
          >
        {%- endif -%}
        <span class="comparison__zoom-marker"></span>
      </div>
      <div class="comparison__zoom-caption">
        <h3 class="comparison__zoom-heading"></h3>
        <p class="comparison__zoom-text"></p>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var section = document.currentScript.closest('.comparison-{{ section.id }}') || document.querySelector('.comparison-{{ section.id }}');
    if (!section) return;

    var markers = section.querySelectorAll('.comparison__marker');
    var legendItems = section.querySelectorAll('.comparison__legend-item');
    var inner = section.querySelector('.comparison__image-inner');
    var outer = section.querySelector('.comparison__image-wrap');

    function clearActive() {
      markers.forEach(function (m) { m.classList.remove('is-active'); });
      legendItems.forEach(function (l) { l.classList.remove('is-active'); });
    }

    function setActive(index) {
      var alreadyActive = section.querySelector('.comparison__marker.is-active[data-marker-index="' + index + '"]');
      clearActive();
      if (alreadyActive) return;
      var marker = section.querySelector('.comparison__marker[data-marker-index="' + index + '"]');
      var legendItem = section.querySelector('.comparison__legend-item[data-legend-index="' + index + '"]');
      if (marker) marker.classList.add('is-active');
      if (legendItem) legendItem.classList.add('is-active');
    }

    var zoomModal = section.querySelector('.comparison__zoom-modal');
    var zoomImage = section.querySelector('.comparison__zoom-image');
    var zoomMarker = section.querySelector('.comparison__zoom-marker');
    var zoomHeading = section.querySelector('.comparison__zoom-heading');
    var zoomText = section.querySelector('.comparison__zoom-text');
    var zoomClose = section.querySelector('.comparison__zoom-modal-close');
    var zoomBackdrop = section.querySelector('.comparison__zoom-modal-backdrop');

    function openZoom(el) {
      var top = el.getAttribute('data-position-top');
      var left = el.getAttribute('data-position-left');
      var heading = el.getAttribute('data-heading');
      var text = el.getAttribute('data-text');
      var index = el.getAttribute('data-marker-index') || el.getAttribute('data-legend-index');

      if (!zoomModal || !zoomImage) return;

      zoomImage.style.transformOrigin = left + '% ' + top + '%';
      zoomImage.style.transform = 'scale(1)';
      zoomMarker.style.top = top + '%';
      zoomMarker.style.left = left + '%';
      zoomMarker.textContent = index;
      zoomHeading.textContent = heading;
      zoomText.textContent = text;

      zoomModal.classList.add('is-open');
      zoomModal.setAttribute('aria-hidden', 'false');

      requestAnimationFrame(function () {
        zoomImage.style.transform = 'scale(2.6)';
      });
    }

    function closeZoom() {
      if (!zoomModal) return;
      zoomModal.classList.remove('is-open');
      zoomModal.setAttribute('aria-hidden', 'true');
      if (zoomImage) zoomImage.style.transform = 'scale(1)';
    }

    if (zoomClose) zoomClose.addEventListener('click', closeZoom);
    if (zoomBackdrop) zoomBackdrop.addEventListener('click', closeZoom);
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') closeZoom();
    });

    markers.forEach(function (marker) {
      marker.addEventListener('click', function () {
        setActive(marker.getAttribute('data-marker-index'));
        openZoom(marker);
      });
    });

    legendItems.forEach(function (item) {
      item.addEventListener('mouseenter', function () {
        setActive(item.getAttribute('data-legend-index'));
      });
      item.addEventListener('click', function () {
        setActive(item.getAttribute('data-legend-index'));
        openZoom(item);
      });
    });

    if (!outer || !inner) return;

    var maxTilt = 12;

    outer.addEventListener('mousemove', function (event) {
      var rect = outer.getBoundingClientRect();
      var x = (event.clientX - rect.left) / rect.width;
      var y = (event.clientY - rect.top) / rect.height;
      var rotateY = (x - 0.5) * maxTilt * 2;
      var rotateX = (0.5 - y) * maxTilt;
      inner.style.transform = 'scale(1.3) rotateX(' + rotateX + 'deg) rotateY(' + rotateY + 'deg)';
    });

    outer.addEventListener('mouseleave', function () {
      inner.style.transform = 'scale(1.3) rotateX(0deg) rotateY(0deg)';
    });
  })();
</script>

{% schema %}
{
  "name": "Comparison table",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
