{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .comparison-{{ section.id }} .comparison__top {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 3.5rem;
  }

  .comparison__heading {
    font-weight: 800;
    letter-spacing: -0.01em;
    margin: 0 0 1rem;
    font-size: 2.8rem;
  }

  @media screen and (min-width: 750px) {
    .comparison__heading {
      font-size: 3.6rem;
    }
  }

  .comparison__subheading {
    font-size: 1.25rem;
    color: rgba(var(--color-foreground), 0.65);
    margin: 0;
  }

  .comparison__table {
    max-width: 1040px;
    margin: 0 auto;
    border-radius: 26px;
    overflow: hidden;
    background: rgb(var(--color-background));
    box-shadow: 0 30px 70px -20px rgba(0, 0, 0, 0.18), 0 2px 8px rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(var(--color-foreground), 0.06);
  }

  .comparison__table-head,
  .comparison__row {
    display: grid;
    grid-template-columns: 1.7fr 1fr 1fr;
    align-items: center;
  }

  .comparison__table-head {
    padding: 1.75rem 2rem;
    background: linear-gradient(120deg, #b81c2e, #d92133 55%, #ef4a58);
  }

  .comparison__table-head span {
    text-align: center;
    font-weight: 800;
    font-size: 1.3rem;
    letter-spacing: 0.01em;
    color: #ffffff;
  }

  .comparison__table-head span:first-child {
    visibility: hidden;
  }

  .comparison__table-head span:nth-child(2) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
  }

  .comparison__table-head span:nth-child(2)::before {
    content: "\2605";
    font-size: 0.85rem;
  }

  .comparison__table-head span:nth-child(3) {
    color: rgba(255, 255, 255, 0.6);
    font-weight: 600;
  }

  .comparison__row {
    padding: 1.75rem 2rem;
    transition: background-color 0.15s ease;
  }

  .comparison__row:nth-child(even) {
    background: rgba(var(--color-foreground), 0.02);
  }

  .comparison__row + .comparison__row {
    border-top: 1px solid rgba(var(--color-foreground), 0.07);
  }

  .comparison__row-label {
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: -0.005em;
  }

  .comparison__cell {
    display: flex;
    justify-content: center;
  }

  .comparison__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    flex: 0 0 auto;
    border-radius: 50%;
  }

  .comparison__mark--yes {
    background: linear-gradient(135deg, #d92133, #ef4a58);
    color: #ffffff;
    box-shadow: 0 6px 14px -2px rgba(217, 33, 51, 0.45);
  }

  .comparison__mark--yes svg {
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .comparison__mark--no {
    background: rgba(var(--color-foreground), 0.07);
    color: rgba(var(--color-foreground), 0.4);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .comparison__features {
    margin-top: 4.5rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.75rem 2rem;
    max-width: 1260px;
    margin-left: auto;
    margin-right: auto;
  }

  @media screen and (min-width: 750px) {
    .comparison__features {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .comparison__feature {
    text-align: center;
  }

  .comparison__feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 5.5rem;
    height: 5.5rem;
    margin-bottom: 1.35rem;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, rgba(217, 33, 51, 0.14), rgba(217, 33, 51, 0.05));
    border: 1px solid rgba(217, 33, 51, 0.15);
  }

  .comparison__feature-icon .svg-wrapper {
    width: 45%;
    height: 45%;
    fill: #d92133;
  }

  .comparison__feature-heading {
    margin: 0 0 0.55rem;
    font-size: 1.3rem;
    font-weight: 800;
  }

  .comparison__feature-text {
    font-size: 1.05rem;
    color: rgba(var(--color-foreground), 0.68);
    line-height: 1.55;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding comparison comparison-{{ section.id }}">
    <div class="comparison__top">
      <h2 class="comparison__heading title {{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>
      {%- if section.settings.subheading != blank -%}
        <p class="comparison__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="comparison__table">
      <div class="comparison__table-head">
        <span></span>
        <span>{{ section.settings.brand_label | escape }}</span>
        <span>{{ section.settings.others_label | escape }}</span>
      </div>
      {%- for block in section.blocks -%}
        {%- if block.type == 'row' -%}
          <div class="comparison__row" {{ block.shopify_attributes }}>
            <p class="comparison__row-label">{{ block.settings.label | escape }}</p>
            <div class="comparison__cell">
              <span class="comparison__mark comparison__mark--yes">
                <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="4 12.5 9.5 18 20 6"></polyline></svg>
              </span>
            </div>
            <div class="comparison__cell">
              <span class="comparison__mark comparison__mark--no" aria-hidden="true">&#10005;</span>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="comparison__features">
      {%- for block in section.blocks -%}
        {%- if block.type == 'feature' -%}
          <div class="comparison__feature" {{ block.shopify_attributes }}>
            <span class="comparison__feature-icon">
              {%- render 'icon-accordion', icon: block.settings.icon -%}
            </span>
            <h3 class="comparison__feature-heading h5">{{ block.settings.heading | escape }}</h3>
            <p class="comparison__feature-text">{{ block.settings.text | escape }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Comparison table",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Title",
      "default": "Overtake vs the rest"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Title size",
      "options": [
        { "value": "h2", "label": "Normal" },
        { "value": "h1", "label": "Large" },
        { "value": "h0", "label": "Extra large" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "See why thousands of racing fans choose us over generic sellers"
    },
    {
      "type": "text",
      "id": "brand_label",
      "label": "Brand column label",
      "default": "Overtake"
    },
    {
      "type": "text",
      "id": "others_label",
      "label": "Other sellers column label",
      "default": "Others"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 44
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Row label",
          "default": "Heavyweight fabric"
        }
      ]
    },
    {
      "type": "feature",
      "name": "Feature icon",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "check_mark", "label": "Checkmark" },
            { "value": "lightning_bolt", "label": "Lightning bolt" },
            { "value": "star", "label": "Star" },
            { "value": "heart", "label": "Heart" },
            { "value": "leather", "label": "Leather" },
            { "value": "shirt", "label": "Shirt" },
            { "value": "truck", "label": "Truck" },
            { "value": "return", "label": "Return" },
            { "value": "lock", "label": "Lock" },
            { "value": "price_tag", "label": "Price tag" }
          ],
          "default": "check_mark"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Title",
          "default": "Quality guarantee"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "[PLACEHOLDER — supporting text]"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison table",
      "blocks": [
        { "type": "row", "settings": { "label": "Heavyweight embroidered fabric" } },
        { "type": "row", "settings": { "label": "Officially inspired vintage designs" } },
        { "type": "row", "settings": { "label": "Tracked worldwide shipping" } },
        { "type": "row", "settings": { "label": "Easy returns & exchanges" } },
        {
          "type": "feature",
          "settings": {
            "icon": "check_mark",
            "heading": "Quality guarantee",
            "text": "If your jacket arrives damaged, we replace it at no cost."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "lightning_bolt",
            "heading": "Premium stitching",
            "text": "Heavyweight fabric with reinforced embroidery on every patch."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "star",
            "heading": "Unique designs",
            "text": "Vintage racing looks you won't find on fast-fashion sites."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "heart",
            "heading": "Instant style upgrade",
            "text": "Turn heads with a jacket that stands out from the grid."
          }
        }
      ]
    }
  ]
}
{% endschema %}
