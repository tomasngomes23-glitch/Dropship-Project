{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .comparison-{{ section.id }} .comparison__top {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 3.5rem;
  }

  .comparison__heading {
    font-weight: 800;
    letter-spacing: -0.01em;
    margin: 0 0 1.25rem;
    font-size: 4rem;
  }

  @media screen and (min-width: 750px) {
    .comparison__heading {
      font-size: 5.2rem;
    }
  }

  .comparison__subheading {
    font-size: 1.7rem;
    color: rgba(var(--color-foreground), 0.65);
    margin: 0;
  }

  .comparison__hint {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin: 0 auto 1.5rem;
    max-width: 1120px;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: rgba(var(--color-foreground), 0.45);
  }

  .comparison__hint svg {
    width: 1.4rem;
    height: 1.4rem;
    stroke: currentColor;
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .comparison__hint .comparison__hint-arrow--left {
    animation: comparison-hint-left 1.6s ease-in-out infinite;
  }

  .comparison__hint .comparison__hint-arrow--right {
    animation: comparison-hint-right 1.6s ease-in-out infinite;
  }

  @keyframes comparison-hint-left {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(-5px); }
  }

  @keyframes comparison-hint-right {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(5px); }
  }

  .comparison__interactive {
    position: relative;
    max-width: 1120px;
    margin: 0 auto;
  }

  .comparison__showcase {
    perspective: 1400px;
    display: flex;
    justify-content: center;
    margin: 0 0 -2.5rem;
    position: relative;
    z-index: 2;
  }

  .comparison__showcase img {
    width: 210px;
    height: 280px;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 25px 30px rgba(0, 0, 0, 0.35));
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
    transform: rotate(-4deg);
  }

  @media screen and (min-width: 990px) {
    .comparison__showcase {
      position: absolute;
      top: 50%;
      left: -6rem;
      transform: translateY(-50%);
      margin: 0;
      z-index: 2;
      pointer-events: none;
    }

    .comparison__showcase img {
      width: 320px;
      height: 420px;
      pointer-events: auto;
    }
  }

  .comparison__table-outer {
    perspective: 1400px;
  }

  .comparison__table {
    border-radius: 26px;
    overflow: hidden;
    background: rgb(var(--color-background));
    box-shadow: 0 30px 70px -20px rgba(0, 0, 0, 0.18), 0 2px 8px rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(var(--color-foreground), 0.06);
    transform-style: preserve-3d;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.4s ease;
    will-change: transform;
  }

  .comparison__table.is-tilting {
    transition: box-shadow 0.4s ease;
    box-shadow: 0 40px 90px -20px rgba(0, 0, 0, 0.28), 0 4px 14px rgba(0, 0, 0, 0.08);
  }

  .comparison__table-head,
  .comparison__row {
    display: grid;
    grid-template-columns: 1.7fr 1fr 1fr;
    align-items: center;
  }

  .comparison__table-head {
    padding: 1.75rem 2rem;
    background: linear-gradient(120deg, #b81c2e, #d92133 55%, #ef4a58);
  }

  .comparison__table-head span {
    text-align: center;
    font-weight: 800;
    font-size: 1.85rem;
    letter-spacing: 0.01em;
    color: #ffffff;
  }

  .comparison__table-head span:first-child {
    visibility: hidden;
  }

  .comparison__table-head span:nth-child(2) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
  }

  .comparison__table-head span:nth-child(2)::before {
    content: "\2605";
    font-size: 1rem;
  }

  .comparison__table-head span:nth-child(3) {
    color: rgba(255, 255, 255, 0.6);
    font-weight: 600;
  }

  .comparison__row {
    padding: 1.75rem 2rem;
    transition: background-color 0.15s ease;
  }

  .comparison__row:nth-child(even) {
    background: rgba(var(--color-foreground), 0.02);
  }

  .comparison__row + .comparison__row {
    border-top: 1px solid rgba(var(--color-foreground), 0.07);
  }

  .comparison__row-label {
    font-weight: 700;
    font-size: 1.7rem;
    letter-spacing: -0.005em;
  }

  .comparison__cell {
    display: flex;
    justify-content: center;
  }

  .comparison__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.2rem;
    height: 3.2rem;
    flex: 0 0 auto;
    border-radius: 50%;
    transition: transform 0.25s ease;
  }

  .comparison__row:hover .comparison__mark {
    transform: scale(1.12) translateZ(20px);
  }

  .comparison__mark--yes {
    background: linear-gradient(135deg, #d92133, #ef4a58);
    color: #ffffff;
    box-shadow: 0 6px 14px -2px rgba(217, 33, 51, 0.45);
  }

  .comparison__mark--yes svg {
    width: 1.65rem;
    height: 1.65rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .comparison__mark--no {
    background: rgba(var(--color-foreground), 0.07);
    color: rgba(var(--color-foreground), 0.4);
    font-size: 1.7rem;
    font-weight: 700;
  }

  .comparison__features {
    margin-top: 4.5rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.75rem 2rem;
    max-width: 1260px;
    margin-left: auto;
    margin-right: auto;
  }

  @media screen and (min-width: 750px) {
    .comparison__features {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .comparison__feature {
    text-align: center;
  }

  .comparison__feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 6.5rem;
    height: 6.5rem;
    margin-bottom: 1.35rem;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, rgba(217, 33, 51, 0.14), rgba(217, 33, 51, 0.05));
    border: 1px solid rgba(217, 33, 51, 0.15);
    transition: transform 0.3s ease;
  }

  .comparison__feature:hover .comparison__feature-icon {
    transform: scale(1.08) rotate(-4deg);
  }

  .comparison__feature-icon .svg-wrapper {
    width: 45%;
    height: 45%;
    fill: #d92133;
  }

  .comparison__feature-heading {
    margin: 0 0 0.55rem;
    font-size: 1.8rem;
    font-weight: 800;
  }

  .comparison__feature-text {
    font-size: 1.35rem;
    color: rgba(var(--color-foreground), 0.68);
    line-height: 1.55;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding comparison comparison-{{ section.id }}">
    <div class="comparison__top">
      <h2 class="comparison__heading title {{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>
      {%- if section.settings.subheading != blank -%}
        <p class="comparison__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <p class="comparison__hint">
      <svg class="comparison__hint-arrow--left" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
      Move your cursor to explore
      <svg class="comparison__hint-arrow--right" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
    </p>

    <div class="comparison__interactive">
      {%- if section.settings.showcase_image != blank -%}
        <div class="comparison__showcase" data-comparison-tilt>
          <img
            src="{{ section.settings.showcase_image | image_url: width: 640 }}"
            alt="{{ section.settings.showcase_image.alt | default: 'Featured jacket' | escape }}"
            width="{{ section.settings.showcase_image.width }}"
            height="{{ section.settings.showcase_image.height }}"
            loading="lazy"
          >
        </div>
      {%- endif -%}

      <div class="comparison__table-outer" data-comparison-tilt>
        <div class="comparison__table">
          <div class="comparison__table-head">
            <span></span>
            <span>{{ section.settings.brand_label | escape }}</span>
            <span>{{ section.settings.others_label | escape }}</span>
          </div>
          {%- for block in section.blocks -%}
            {%- if block.type == 'row' -%}
              <div class="comparison__row" {{ block.shopify_attributes }}>
                <p class="comparison__row-label">{{ block.settings.label | escape }}</p>
                <div class="comparison__cell">
                  <span class="comparison__mark comparison__mark--yes">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="4 12.5 9.5 18 20 6"></polyline></svg>
                  </span>
                </div>
                <div class="comparison__cell">
                  <span class="comparison__mark comparison__mark--no" aria-hidden="true">&#10005;</span>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>

    <div class="comparison__features">
      {%- for block in section.blocks -%}
        {%- if block.type == 'feature' -%}
          <div class="comparison__feature" {{ block.shopify_attributes }}>
            <span class="comparison__feature-icon">
              {%- render 'icon-accordion', icon: block.settings.icon -%}
            </span>
            <h3 class="comparison__feature-heading h5">{{ block.settings.heading | escape }}</h3>
            <p class="comparison__feature-text">{{ block.settings.text | escape }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var isCoarsePointer = window.matchMedia('(pointer: coarse)').matches;
    if (isCoarsePointer) return;

    var outers = document.querySelectorAll('.comparison-{{ section.id }} [data-comparison-tilt]');

    outers.forEach(function (outer) {
      var card = outer.querySelector('.comparison__table, .comparison__showcase img');
      if (!card) return;

      var isShowcase = card.tagName === 'IMG';
      var baseTransform = isShowcase ? 'rotate(-4deg) ' : '';
      var maxTilt = 11;

      function onMove(event) {
        var rect = outer.getBoundingClientRect();
        var x = (event.clientX - rect.left) / rect.width;
        var y = (event.clientY - rect.top) / rect.height;
        var rotateY = (x - 0.5) * maxTilt * 2;
        var rotateX = (0.5 - y) * maxTilt;
        card.style.transform = baseTransform + 'rotateX(' + rotateX + 'deg) rotateY(' + rotateY + 'deg)';
      }

      function onEnter() {
        card.classList.add('is-tilting');
      }

      function onLeave() {
        card.classList.remove('is-tilting');
        card.style.transform = baseTransform + 'rotateX(0deg) rotateY(0deg)';
      }

      outer.addEventListener('mouseenter', onEnter);
      outer.addEventListener('mousemove', onMove);
      outer.addEventListener('mouseleave', onLeave);
    });
  })();
</script>

{% schema %}
{
  "name": "Comparison table",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Title",
      "default": "Overtake vs the rest"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Title size",
      "options": [
        { "value": "h2", "label": "Normal" },
        { "value": "h1", "label": "Large" },
        { "value": "h0", "label": "Extra large" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "See why thousands of racing fans choose us over generic sellers"
    },
    {
      "type": "image_picker",
      "id": "showcase_image",
      "label": "Interactive product cutout",
      "info": "Use a cutout image (transparent background) so it overlaps the table naturally."
    },
    {
      "type": "text",
      "id": "brand_label",
      "label": "Brand column label",
      "default": "Overtake"
    },
    {
      "type": "text",
      "id": "others_label",
      "label": "Other sellers column label",
      "default": "Others"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 44
    }
  ],
  "blocks": [
    {
      "type": "row",
