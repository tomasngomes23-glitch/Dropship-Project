    "reviews": {
      "type": "reviews-matchday",
      "blocks": {
        "review-1": { "type": "review", "settings": { "reviewer_name": "Marco T.", "detail": "Bought: M · Player Version", "rating": "5", "verified": true, "body": "Print is razor sharp and the fabric feels exactly like the boxed version I've owned before. Ordered Monday, had it by Friday. Didn't expect that from an independent shop." } },
        "review-2": { "type": "review", "settings": { "reviewer_name": "Sophie K.", "detail": "Bought: L · Fan Version", "rating": "5", "verified": true, "body": "Fan Version is soft, breathable and true to size. Wore it to a five-a-side and it held up through a full wash cycle with zero cracking on the badge." } },
        "review-3": { "type": "review", "settings": { "reviewer_name": "Diego R.", "detail": "Bought: XL · Player Version", "rating": "4", "verified": true, "body": "Player cut runs slim, so go a size up from what you'd normally wear. Once I exchanged for the XL it fit great. Print quality is genuinely excellent." } },
        "review-4": { "type": "review", "settings": { "reviewer_name": "Aisha N.", "detail": "Bought: S · Fan Version", "rating": "5", "verified": true, "body": "Bought this as a birthday gift for my brother and he wore it the same day. Arrived quicker than the estimate said, packaging was tidy too." } },
        "review-5": { "type": "review", "settings": { "reviewer_name": "Tomás P.", "detail": "Bought: M · Player Version", "rating": "5", "verified": true, "body": "Was honestly skeptical about an unofficial print holding up, but this is on par with shirts I've paid double for elsewhere. Stitching on the crest is clean, no loose threads." } },
        "review-6": { "type": "review", "settings": { "reviewer_name": "Harriet W.", "detail": "Bought: L · Fan Version", "rating": "3", "verified": true, "body": "Shirt itself is comfortable but the print on the sleeve badge started lifting slightly at the edge after about six washes. Support replaced it without hassle, so the service saved the experience." } },
        "review-7": { "type": "review", "settings": { "reviewer_name": "Jamal O.", "detail": "Bought: M · Fan Version", "rating": "5", "verified": true, "body": "Compared this to a kit I bought years ago from an official store and the fabric weight is nearly identical. Colours haven't faded after a month of regular wear." } },
        "review-8": { "type": "review", "settings": { "reviewer_name": "Elena V.", "detail": "Bought: S · Player Version", "rating": "5", "verified": true, "body": "Player fit is snug and athletic like it should be. If you're between sizes for the Player Version, size up — the cut is closer to a true athletic fit than the Fan Version." } },
        "review-9": { "type": "review", "settings": { "reviewer_name": "Connor B.", "detail": "Bought: L · Fan Version", "rating": "4", "verified": true, "body": "Took about nine days longer than the delivery estimate, which was frustrating, but the shirt that showed up was worth the wait. Great print, comfortable fit." } },
        "review-10": { "type": "review", "settings": { "reviewer_name": "Priya S.", "detail": "Bought: M · Player Version + Fan Version", "rating": "5", "verified": true, "body": "Ordered both versions to compare. Player Version fabric is noticeably lighter and more fitted, Fan Version is heavier cotton-feel and more relaxed. Both prints are equally sharp — just pick based on how you plan to wear it." } },
        "review-11": { "type": "review", "settings": { "reviewer_name": "Lucas F.", "detail": "Bought: XL · Fan Version", "rating": "5", "verified": true, "body": "Relaxed, comfy fit and the colours are more vivid in person than in the photos. This is my third order from them and the consistency has been solid every time." } },
        "review-12": { "type": "review", "settings": { "reviewer_name": "Grace M.", "detail": "Bought: M · Fan Version", "rating": "5", "verified": true, "body": "First time buying from an independent kit shop instead of an official store and I was nervous about print quality. No complaints at all — looks legit and feels legit." } },
        "review-13": { "type": "review", "settings": { "reviewer_name": "Noah D.", "detail": "Bought: L · Player Version", "rating": "4", "verified": true, "body": "Stitching around the collar is neat and the size chart on the product page was accurate for once. Only reason it's not five stars is the badge sits slightly off-centre on mine." } },
        "review-14": { "type": "review", "settings": { "reviewer_name": "Isabela C.", "detail": "Bought: S · Fan Version", "rating": "5", "verified": true, "body": "Bought this for my daughter and the fabric is noticeably soft, no itchy tag or scratchy print. She's worn it every weekend since it arrived." } },
        "review-15": { "type": "review", "settings": { "reviewer_name": "Ryan K.", "detail": "Bought: M · Fan Version", "rating": "3", "verified": true, "body": "Colour is a touch darker in person than the product photos showed. Still a decent shirt for the price, just wanted to flag it in case you're picky about exact shade matching." } },
        "review-16": { "type": "review", "settings": { "reviewer_name": "Fatima Z.", "detail": "Bought: L · Player Version", "rating": "5", "verified": true, "body": "About as close to a matchday shirt as you'll get from an independent brand. Breathable fabric, held up through a full 90 minutes plus extra time without clinging." } },
        "review-17": { "type": "review", "settings": { "reviewer_name": "Owen H.", "detail": "Bought: XL · Fan Version", "rating": "5", "verified": true, "body": "Messaged support before ordering with a sizing question and got a genuinely helpful reply within a couple hours, not a canned response. Shirt fits exactly as they described." } },
        "review-18": { "type": "review", "settings": { "reviewer_name": "Nadia S.", "detail": "Bought: M · Player Version", "rating": "5", "verified": true, "body": "Number printing on the back is sharp with no cracking after several washes on a cold cycle. Genuinely impressed for an unofficial print." } },
        "review-19": { "type": "review", "settings": { "reviewer_name": "Ben C.", "detail": "Bought: S · Fan Version", "rating": "4", "verified": true, "body": "Runs a little large in the Fan Version, could've gone down a size. Exchange process was easy though and the second one fits well." } },
        "review-20": { "type": "review", "settings": { "reviewer_name": "Camila R.", "detail": "Bought: L · Fan Version", "rating": "5", "verified": true, "body": "Shipping was faster than expected and the shirt was a hit as a gift — everyone at the party asked where it was from. Quality genuinely surprised me." } }
      },
