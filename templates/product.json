{
  "layout": "theme",
  "sections": {
    "main-product": {
      "type": "main-product",
      "blocks": {
        "title": { "type": "title" },
        "loox_rating": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% if product.metafields.loox.num_reviews != blank and product.metafields.loox.num_reviews != '0' %}<div class=\"f1-loox-inline\"><div class=\"loox-rating\" data-id=\"{{ product.id }}\" data-rating=\"{{ product.metafields.loox.avg_rating }}\" data-raters=\"{{ product.metafields.loox.num_reviews }}\"></div><a href=\"#looxReviews\" class=\"link caption\">{{ product.metafields.loox.num_reviews }} reviews</a></div>{% endif %}"
          }
        },
        "price": { "type": "price" },
        "inventory": {
          "type": "inventory",
          "settings": {
            "text_style": "uppercase",
            "inventory_threshold": 5,
            "show_inventory_quantity": true
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button"
          }
        },
        "quantity_selector": { "type": "quantity_selector" },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "trust_badges": {
          "type": "icon-with-text",
          "settings": {
            "layout": "horizontal",
            "icon_1": "truck",
            "heading_1": "Free Shipping",
            "icon_2": "lock",
            "heading_2": "Secure Checkout",
            "icon_3": "check_mark",
            "heading_3": "100% Licensed Team Gear"
          }
        },
        "description": { "type": "description" },
        "shipping_returns": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping & Returns",
            "icon": "truck",
            "content": "<p>Orders ship within 1-2 business days. 30-day returns on unworn items with tags attached.</p>"
          }
        },
        "size_guide": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Size Guide",
            "icon": "ruler",
            "content": "<p>Team kits run true to size. Check the size chart in the product images if you're between sizes.</p>"
          }
        },
        "share": { "type": "share" },
        "loox_reviews_full": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div id=\"looxReviews\"></div>"
          }
        }
      },
      "block_order": [
        "title",
        "loox_rating",
        "price",
        "inventory",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "trust_badges",
        "description",
        "shipping_returns",
        "size_guide",
        "share",
        "loox_reviews_full"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "gallery_layout": "stacked",
        "media_position": "left",
        "image_zoom": "hover",
        "mobile_thumbnails": "columns",
        "hide_variants": false,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "related-by-team": {
      "type": "related-by-team",
      "settings": {
        "heading": "More from",
        "heading_size": "h1",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "adapt",
        "show_secondary_image": true,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 48
      }
    }
  },
  "order": ["main-product", "related-by-team"]
}
